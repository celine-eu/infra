{{- /* Redis requires a password where `redis.password` is set (store plan
       redis-requires-a-password): one requirepass, kept in the Secret `redis-auth` that this
       release renders; oauth2-proxy reads the same Secret. The chart's own Secret is not used:
       it keeps the first password it finds in the cluster, so a rotation would not reach it.
       Prod refuses to render without a password. Elsewhere no password leaves Redis open, as
       before, until Prefect and Superset read one too (plan, phase 1). */}}
{{- $password := .Environment.Values | dig "redis" "password" "" | toString }}
{{- if and (eq .Environment.Name "prod") (eq $password "") }}
{{- fail "redis.password is required on prod: Redis holds every user's oauth2-proxy session" }}
{{- end }}
{{- /* `pod_disruption.redis` (defaults/0050-celine-services/pod-disruption.yaml.gotmpl):
       a PodDisruptionBudget (the chart has none) and pod annotations, so a node scale-down
       does not take every session with it. Absent, nothing changes. */}}
{{- $pd := .Environment.Values | dig "pod_disruption" .Release.Name (dict) | default (dict) }}
{{- $annotations := deepCopy ($pd | dig "pod_annotations" (dict)) }}
{{- $objects := list }}
{{- if $password }}
{{- $_ := set $annotations "checksum/redis-auth" ($password | sha256sum) }}
{{- $objects = append $objects (dict "apiVersion" "v1" "kind" "Secret" "metadata" (dict "name" "redis-auth") "type" "Opaque" "stringData" (dict "password" $password)) }}
{{- end }}
{{- if eq (toString ($pd | dig "pdb" false)) "true" }}
{{- $objects = append $objects (dict "apiVersion" "policy/v1" "kind" "PodDisruptionBudget" "metadata" (dict "name" .Release.Name) "spec" (dict "maxUnavailable" ($pd | dig "max_unavailable" 0 | int) "selector" (dict "matchLabels" (dict "app.kubernetes.io/name" "redis" "app.kubernetes.io/instance" .Release.Name)))) }}
{{- end }}
{{- if $password }}
auth:
  enabled: true
  existingSecret: redis-auth
  existingSecretPasswordKey: password
{{- else }}
auth:
  enabled: false
{{- end }}

# A changed password restarts Redis (oauth2-proxy carries the same annotation).
{{- with $annotations }}
podAnnotations:
  {{- toYaml . | nindent 2 }}
{{- end }}

# The Secret `redis-auth` (with a password) and the PodDisruptionBudget (with
# pod_disruption.redis.pdb).
{{- with $objects }}
extraObjects:
  {{- toYaml . | nindent 2 }}
{{- end }}

# Pod Security `restricted`: the chart's context (uid 999, non-root, no privilege
# escalation) plus no capabilities.
containerSecurityContext:
  runAsUser: 999
  runAsNonRoot: true
  allowPrivilegeEscalation: false
  capabilities:
    drop: [ALL]
