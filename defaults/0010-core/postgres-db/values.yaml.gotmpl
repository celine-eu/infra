{{- /* The add-on layer's databases (README, "Add-on layer"): with `dataspace.enabled`, each
       name in `dataspace.databases` is a role and a database of the same name, shaped like
       every role below. Its password is `postgres_db.<name>`, as mandatory as theirs. */}}
{{- $dsOn := .Environment.Values | dig "dataspace" "enabled" false }}
{{- if not (kindIs "bool" $dsOn) }}
{{- fail (printf "dataspace.enabled must be true or false, got %v" $dsOn) }}
{{- end }}
{{- $dsDatabases := list }}
{{- if $dsOn }}
{{- $dsDatabases = .Environment.Values | dig "dataspace" "databases" nil }}
{{- if not (kindIs "slice" $dsDatabases) }}
{{- fail "dataspace.enabled is true: dataspace.databases must be a list of role/database names (an empty list for none)" }}
{{- end }}
{{- $seen := dict }}
{{- range $dsDatabases }}
{{- if not (and (kindIs "string" .) (regexMatch "^[a-z_][a-z0-9_]{0,62}$" .)) }}
{{- fail (printf "dataspace.databases: %v is not a role name (lower-case letters, digits and _, starting with a letter or _)" .) }}
{{- end }}
{{- if hasKey $seen . }}
{{- fail (printf "dataspace.databases: %s is listed twice" .) }}
{{- end }}
{{- $_ := set $seen . true }}
{{- if not ($.Environment.Values | dig "postgres_db" . "") }}
{{- fail (printf "dataspace.databases lists %s: postgres_db.%s (its role password) is required in the environment's secrets" . .) }}
{{- end }}
{{- end }}
{{- end }}
{{- /* The warehouse tools' roles and databases (superset, meltano, prefect, marquez):
       `postgres_db.warehouse_tools` lists the ones this environment hosts, default all four.
       An environment that runs none of them (prod, ADR-0001) sets an empty list and needs
       none of their passwords; a listed tool's password is `postgres_db.<name>`, as mandatory
       as every other role's. Turning one back on: list it and add its password. */}}
{{- $knownTools := list "superset" "meltano" "prefect" "marquez" }}
{{- $tools := .Environment.Values | dig "postgres_db" "warehouse_tools" $knownTools }}
{{- if not (kindIs "slice" $tools) }}
{{- fail (printf "postgres_db.warehouse_tools must be a list (an empty list for none), got %v" $tools) }}
{{- end }}
{{- range $tools }}
{{- if not (has . $knownTools) }}
{{- fail (printf "postgres_db.warehouse_tools: %v is not one of %s" . (join ", " $knownTools)) }}
{{- end }}
{{- end }}
cluster:
  name: postgis1
  image: ghcr.io/cloudnative-pg/postgis:17
  instances: 1
  {{- /* Sizing, optional per environment: `postgres_db.resources` replaces the chart's
         requests/limits, `postgres_db.parameters` overrides single Postgres parameters
         (shared_buffers and effective_cache_size should follow the memory). */}}
  {{- with .Environment.Values | dig "postgres_db" "resources" nil }}
  resources: {{ toJson . }}
  {{- end }}
  storage:
    size: {{ .Environment.Values | dig "postgres_db" "storage_size" "10Gi" }}
  {{- $params := dict "log_statement" "ddl" "max_connections" "200" "idle_in_transaction_session_timeout" "30000" }}
  {{- range $k, $v := .Environment.Values | dig "postgres_db" "parameters" (dict) }}
  {{- $_ := set $params $k (toString $v) }}
  {{- end }}
  parameters:
    {{- range $k, $v := $params }}
    {{ $k }}: {{ $v | quote }}
    {{- end }}

{{- /* `postgres_db.job_resources`: the post-deploy Jobs; `postgres_db.pooler_resources`:
       each pgbouncer. Unset, the pods declare none. */}}
{{- with .Environment.Values | dig "postgres_db" "job_resources" nil }}
jobResources: {{ toJson . }}
{{- end }}

{{- /* `postgres_db.sync_environment` (dev | prod): the marker sync_tables requires on
       `datasets`, written by its owner. No default: unset, no marker, every sync refused. */}}
{{- with .Environment.Values | dig "postgres_db" "sync_environment" nil }}
envMarker:
  environment: {{ . | quote }}
  database: datasets
  secret: postgis1-datasets-connection-string
{{- end }}

roles:
  - name: datasets_owner
    password: {{ .Environment.Values.postgres_db.datasets_owner | quote }}
    comment: "User owning the datasets schema"

  - name: datasets_ro
    password: {{ .Environment.Values.postgres_db.datasets_ro | quote }}
    comment: "Read-only access to datasets"

{{- if has "meltano" $tools }}
  - name: meltano
    password: {{ .Environment.Values.postgres_db.meltano | quote }}
{{- end }}
{{- if has "prefect" $tools }}
  - name: prefect
    password: {{ .Environment.Values.postgres_db.prefect | quote }}
{{- end }}
{{- if has "superset" $tools }}
  - name: superset
    password: {{ .Environment.Values.postgres_db.superset | quote }}
{{- end }}
  - name: keycloak
    password: {{ .Environment.Values.postgres_db.keycloak | quote }}
{{- if has "marquez" $tools }}
  - name: marquez
    password: {{ .Environment.Values.postgres_db.marquez | quote }}
{{- end }}

  - name: nudging
    password: {{ .Environment.Values.postgres_db.nudging | quote }}
  - name: dataset_api
    password: {{ .Environment.Values.postgres_db.dataset_api | quote }}
  - name: rec_registry
    password: {{ .Environment.Values.postgres_db.rec_registry | quote }}
  - name: ai_assistant
    password: {{ .Environment.Values.postgres_db.ai_assistant | quote }}
  - name: webapp
    password: {{ .Environment.Values.postgres_db.webapp | quote }}
  - name: flexibility_api
    password: {{ .Environment.Values.postgres_db.flexibility_api | quote }}
  - name: grid
    password: {{ .Environment.Values.postgres_db.grid | quote }}
  - name: roi
    password: {{ .Environment.Values.postgres_db.roi | quote }}
  - name: community
    password: {{ .Environment.Values.postgres_db.community | quote }}
{{- /* Only where onboarding is on: its role password is then as mandatory as
       every other role's, and an environment without onboarding needs no key. */}}
{{- if .Environment.Values | dig "onboarding" "enabled" false }}
  - name: onboarding
    password: {{ .Environment.Values.postgres_db.onboarding | quote }}
{{- end }}
{{- range $dsDatabases }}
  - name: {{ . }}
    password: {{ index $.Environment.Values.postgres_db . | quote }}
{{- end }}

databases:
  - name: datasets
    owner: datasets_owner
    extensions:
      - postgis
      - postgis_topology
      - fuzzystrmatch
      - postgis_tiger_geocoder

  - name: keycloak
    owner: keycloak

{{- range $tools }}

  - name: {{ . }}
    owner: {{ . }}
{{- end }}

  - name: nudging
    owner: nudging
  - name: rec_registry
    owner: rec_registry
  - name: ai_assistant
    owner: ai_assistant
  - name: webapp
    owner: webapp
  - name: dataset_api
    owner: dataset_api
  - name: flexibility_api
    owner: flexibility_api
  - name: grid
    owner: grid
  - name: roi
    owner: roi
  - name: community
    owner: community
{{- if .Environment.Values | dig "onboarding" "enabled" false }}
  - name: onboarding
    owner: onboarding
{{- end }}
{{- range $dsDatabases }}
  - name: {{ . }}
    owner: {{ . }}
{{- end }}

poolers:
  - type: rw
    instances: 2
    poolMode: transaction
    parameters:
      default_pool_size: "25"
      max_client_conn: "200"
      max_prepared_statements: "256"
      server_reset_query_always: "1"
    {{- with .Environment.Values | dig "postgres_db" "pooler_resources" nil }}
    resources: {{ toJson . }}
    {{- end }}

connection_strings:
  - database: datasets
    user: datasets_owner

  - database: datasets
    user: datasets_ro
    name: datasets-readonly
    dialect: postgresql+asyncpg

  - database: datasets
    user: datasets_owner
    name: datasets-async
    dialect: postgresql+asyncpg

  - database: dataset_api
    dialect: postgresql+asyncpg

{{- if has "prefect" $tools }}

  - database: prefect
    dialect: postgresql+asyncpg
    host: postgis1-pooler-rw
{{- end }}
{{- if has "meltano" $tools }}

  - database: meltano
{{- end }}

  - database: nudging
    dialect: postgresql+asyncpg

  - database: rec_registry
    dialect: postgresql+asyncpg

  - database: ai_assistant
    dialect: postgresql+asyncpg

  - database: webapp
    dialect: postgresql+asyncpg

  - database: flexibility_api
    dialect: postgresql+asyncpg

  - database: grid
    dialect: postgresql+asyncpg

  - database: roi
    dialect: postgresql+asyncpg

  - database: community
    dialect: postgresql+asyncpg
{{- if .Environment.Values | dig "onboarding" "enabled" false }}
  - database: onboarding
    dialect: postgresql+asyncpg
{{- end }}


backup:
  enabled: {{ .Environment.Values | dig "postgres_db" "backup" "enabled" false }}
  destinationPath: {{ .Environment.Values | dig "postgres_db" "backup" "destinationPath" "" | quote }}
  retentionPolicy: {{ .Environment.Values | dig "postgres_db" "backup" "retentionPolicy" "7d" | quote }}
  schedule: {{ .Environment.Values | dig "postgres_db" "backup" "schedule" "0 2 * * *" | quote }}
  compression: {{ .Environment.Values | dig "postgres_db" "backup" "compression" "gzip" | quote }}
  gcs:
    applicationCredentials: {{ .Environment.Values | dig "postgres_db" "backup" "gcs" "applicationCredentials" "" | quote }}
  s3:
    endpointURL: {{ .Environment.Values | dig "postgres_db" "backup" "s3" "endpointURL" "" | quote }}
    accessKey: {{ .Environment.Values | dig "postgres_db" "backup" "s3" "accessKey" "" | quote }}
    secretKey: {{ .Environment.Values | dig "postgres_db" "backup" "s3" "secretKey" "" | quote }}
    checksums: {{ .Environment.Values | dig "postgres_db" "backup" "s3" "checksums" "" | quote }}

{{- /* Tunes prefect's hot tables only: on where prefect's database is. */}}
table_tuning:
  enabled: {{ has "prefect" $tools }}
  image: ghcr.io/cloudnative-pg/postgis:17
  databases:
    - name: prefect
      secret: postgis1-prefect-connection-string
      tables:
        - name: deployment
          options: "fillfactor = 50, autovacuum_vacuum_scale_factor = 0.01, autovacuum_vacuum_cost_delay = 0"
        - name: work_queue
          options: "fillfactor = 50, autovacuum_vacuum_scale_factor = 0.01, autovacuum_vacuum_cost_delay = 0"
        - name: flow_run
          options: "fillfactor = 50, autovacuum_vacuum_scale_factor = 0.01, autovacuum_vacuum_cost_delay = 0"
        - name: concurrency_limit_v2
          options: "autovacuum_vacuum_scale_factor = 0.01, autovacuum_vacuum_cost_delay = 0"

grants:
  enabled: true
  database: datasets
  role: datasets_ro
  secret: postgis1-datasets-connection-string
  schemas:
    - ds_dev_gold
    - ds_dev_raw
    - ds_dev_silver
    - ds_dev_staging
    - raw
