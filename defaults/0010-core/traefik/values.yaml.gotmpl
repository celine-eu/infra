# defaults/0010-core/traefik/values.yaml.gotmpl
#
# The ingress controller infra installs where an environment has none of its own
# (helmfile.d/0010-core.yaml.gotmpl, `installed` on `ingress_controller.enabled`).
# Traefik's NGINX provider serves the `nginx` IngressClass and reads the
# nginx.ingress.kubernetes.io/* annotations every chart here already sets, so no Ingress
# changes. Environment keys, all optional:
#
#   ingress_controller:
#     enabled: false                    # install it at all
#     namespace: ingress
#     class: nginx                      # the IngressClass the charts use
#     controller_class: k8s.io/ingress-nginx
#                                       # what the IngressClass names as its controller.
#                                       # Any other ingress-nginx in the cluster answers
#                                       # every class naming k8s.io/ingress-nginx: where
#                                       # one runs, set a class and a controller of
#                                       # Traefik's own, so the two never share an Ingress
#     replicas: 2
#     service:
#       annotations: {}                 # provider-specific load-balancer annotations
#       externalTrafficPolicy: Local    # keeps the client address (whitelist-source-range,
#                                       # forwarded_allow_ips); Cluster spreads load instead
#     resources:                        # requests are what some clusters bill by
#       requests: { cpu: 250m, memory: 256Mi }
#       limits: { memory: 512Mi }
#     crd_provider: false               # also serve Traefik's own resources (IngressRoute,
#                                       # TLSOption, Middleware), for what the NGINX
#                                       # provider cannot express (client certificates
#                                       # checked per host). Only those carrying the
#                                       # class's annotation, and only in their namespace.
#     drain_seconds: 45                 # preStop sleep: with externalTrafficPolicy Local a
#                                       # node whose pod is gone refuses connections until
#                                       # the load balancer's health check drops it; the
#                                       # pod keeps serving meanwhile. 0: no sleep
#     allowed_response_headers: []      # added to the security headers below, which the
#                                       # charts' custom-headers ConfigMaps set
#
# The NGINX provider sets a custom-headers header only if it is allowed
# (ingress-nginx's global-allowed-response-headers); otherwise it answers 503 on every path
# of that Ingress. Allowed by default: the README's "Security headers" list.
#
# On GKE Autopilot a node scale-down moved a Traefik pod and refused about half the
# connections for a minute; the preStop sleep drains a moving pod instead. Neither
# safe-to-evict "false" (Autopilot makes such pods extended-duration pods: 500m CPU / 512Mi
# each, on a node pool of their own) nor a pod anti-affinity (500m CPU minimum there). Never
# two on one node (two replicas on one node are no redundancy): a topology spread.
{{- $ic := .Values | dig "ingress_controller" (dict) }}
{{- $class := $ic | dig "class" "nginx" }}
{{- $controller := $ic | dig "controller_class" "k8s.io/ingress-nginx" }}
{{- $svc := $ic | dig "service" (dict) }}
{{- $drain := $ic | dig "drain_seconds" 45 | int }}
{{- $headers := list "X-Content-Type-Options" "Referrer-Policy" "X-Frame-Options" "Permissions-Policy" "Strict-Transport-Security" "Content-Security-Policy" "Content-Security-Policy-Report-Only" }}
{{- $headers = concat $headers ($ic | dig "allowed_response_headers" (list)) | uniq }}

deployment:
  replicas: {{ $ic | dig "replicas" 2 }}
  # The sleep plus Traefik's own shutdown (graceTimeOut, 10 s by default).
  terminationGracePeriodSeconds: {{ max 60 (add $drain 30) }}
  {{- if gt $drain 0 }}
  lifecycle:
    preStop:
      sleep:
        seconds: {{ $drain }}
  {{- end }}

podDisruptionBudget:
  enabled: true
  minAvailable: 1

# One pod per node; each rollout's pods counted on their own (pod-template-hash), so the
# old ones do not block the new.
topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: kubernetes.io/hostname
    whenUnsatisfiable: DoNotSchedule
    matchLabelKeys: [pod-template-hash]
    labelSelector:
      matchLabels:
        app.kubernetes.io/name: traefik
        app.kubernetes.io/instance: traefik-{{ $ic | dig "namespace" "ingress" }}

# No Traefik IngressClass: the controller answers for `{{ $class }}` only, below.
ingressClass:
  enabled: false

providers:
  kubernetesCRD:
    enabled: {{ $ic | dig "crd_provider" false }}
    ingressClass: {{ $class | quote }}
    allowCrossNamespace: false
    allowExternalNameServices: false
  kubernetesIngress:
    enabled: false
  kubernetesIngressNGINX:
    enabled: true
    ingressClass: {{ $class | quote }}
    controllerClass: {{ $controller | quote }}
    globalAllowedResponseHeaders: {{ $headers | toJson }}
    publishService:
      enabled: true

ingressRoute:
  dashboard:
    enabled: false

service:
  annotations: {{ $svc | dig "annotations" (dict) | toJson }}
  spec:
    type: LoadBalancer
    externalTrafficPolicy: {{ $svc | dig "externalTrafficPolicy" "Local" }}

resources: {{ $ic | dig "resources" (dict "requests" (dict "cpu" "250m" "memory" "256Mi") "limits" (dict "memory" "512Mi")) | toJson }}

# The IngressClass the charts reference, claimed by the NGINX provider's controller class.
extraObjects:
  - apiVersion: networking.k8s.io/v1
    kind: IngressClass
    metadata:
      name: {{ $class | quote }}
    spec:
      controller: {{ $controller | quote }}
