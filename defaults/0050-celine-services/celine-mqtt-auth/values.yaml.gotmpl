
image:
  tag: {{ .Values.mqtt_auth.image_tag | default "latest" | quote }}

extraEnv:
  - name: CELINE_MQTT_POLICY_PACKAGE
    value: "celine.mqtt.acl"

oidc:
  service:
    # CELINE_OIDC_AUDIENCE: the audience every MQTT client token must carry. celine-policies
    # >= 1.7.0 enforces it; only a token requested with the `mqtt` scope carries `svc-mqtt`.
    audience: {{ .Environment.Values | dig "mqtt_auth" "audience" "svc-mqtt" | quote }}
    clientSecret: {{ .Environment.Values | dig "mqtt_auth" "client_secret" "svc-mqtt-auth" | quote }}

{{- with .Environment.Values | dig "mqtt_auth" "resources" nil }}
resources:
  {{- toYaml . | nindent 2 }}
{{- end }}
