# defaults/0050-celine-services/celine-frontend-roi/values.yaml.gotmpl
#
# The ROI calculator is public by design: no sign-in, the API behind it takes no token.
# Only the feedback paths (ingress.authPaths, chart default) need an existing SSO session:
# without one they answer 401, never a redirect to sign in.
# What an anonymous caller can cost is bounded twice - here at the edge, per client
# address, on the API paths only, and again inside roi (see celine-roi).
#
#   frontend_roi:
#     edge_limit_rps: 2            # requests/s per client address on the API (burst x5)
#     edge_limit_connections: 10   # concurrent connections per client address on the API
{{- $f := .Environment.Values | dig "frontend_roi" dict }}

image:
  tag: {{ $f | dig "image_tag" "latest" | quote }}

ingress:
  host: roi.{{ .Environment.Values.domain }}
  domain: {{ .Environment.Values.domain }}
  auth:
    enabled: false
  apiAnnotations:
    nginx.ingress.kubernetes.io/limit-rps: {{ $f | dig "edge_limit_rps" 2 | toString | quote }}
    nginx.ingress.kubernetes.io/limit-connections: {{ $f | dig "edge_limit_connections" 10 | toString | quote }}

# The development-version banner (celine-frontend `EnvBanner`): PUBLIC_CELINE_ENV is
# CELINE_ENV's value (`celine_env`, else the environment's name); outside prod,
# PUBLIC_CELINE_PROD_URL is this host on prod's domain (`prod_reads.domain`), the banner's link.
{{- $celineEnv := .Values | dig "celine_env" .Environment.Name | toString }}
{{- $prodDomain := .Values | dig "prod_reads" "domain" "" | toString }}
extraEnv:
  - name: PUBLIC_CELINE_ENV
    value: {{ $celineEnv | quote }}
  {{- if and $prodDomain (ne ($celineEnv | trim | lower) "prod") }}
  - name: PUBLIC_CELINE_PROD_URL
    value: {{ printf "https://roi.%s" $prodDomain | quote }}
  {{- end }}

# IngressClass of every Ingress (`ingress_controller.class`, default nginx).
ingressClassName: {{ .Values | dig "ingress_controller" "class" "nginx" | quote }}

# Images pinned by digest where the environment lists them (`image_digests`,
# {repository: {tag: sha256:…}}; celine-services.imageRef). Empty: images by tag.
imageDigests: {{ .Values | dig "image_digests" (dict) | toJson }}
