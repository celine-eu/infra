# defaults/0050-celine-services/sync-tables/values.yaml.gotmpl
#
# sync_tables' exchange layer (charts/sync-tables). Installed where `sync_tables.sink.enabled`
# or `sync_tables.push_source.enabled` is true. Environment keys:
#
#   sync_tables:
#     image: ""                         # required: the released image, by tag or digest
#     sink:                             # the environment that receives (prod)
#       enabled: false
#       host: sync.<domain>
#       dsn_secret: { name: "", key: connection-string }   # the mirror role's DSN, required
#       allow_schemas: []               # required: the only schemas it writes
#       ingress_flavor: ""              # required: traefik (native IngressRoute + TLSOption,
#                                       # needs ingress_controller.crd_provider) or nginx
#       allow_source_ranges: ""         # the source's egress CIDRs; required with traefik
#       ingress_namespace: ingress      # where the ingress controller runs (NetworkPolicy)
#       auth_limits: {}                 # optional: failMax, failWindow, lockout, failGlobalMax
#       tokens: {}                      # secret: {holder: token}, e.g. {push: …}
#       ca: ""                          # secret: PEM, the push CA
#       server_cert: ""                 # secret: PEM, the sink host's certificate (push CA)
#       server_key: ""                  # secret: PEM
#       resources: {}
#       pod_annotations: {}             # e.g. cluster-autoscaler.kubernetes.io/safe-to-evict:
#                                       # "false", so the autoscaler never moves it mid-push
#       pdb: false                      # true: a PodDisruptionBudget, maxUnavailable 0
#     push_source:                      # the environment that sends (staging)
#       enabled: false
#       schedule: "*/30 * * * *"
#       sink_url: ""                    # required: wss://<sink host>/sync/v1
#       source_secret: { name: postgis1-datasets-connection-string, key: connection-string }
#       profile: ""                     # required: the table list, as YAML text (an
#                                       # environment file reads it from the deployment)
#       token: ""                       # secret: the sink's token for this source
#       ca: ""                          # secret: PEM, the push CA
#       client_cert: ""                 # secret: PEM
#       client_key: ""                  # secret: PEM
#       resources: {}
#     serve:                            # the environment developers pull from (staging):
#                                       # `sync-tables serve` behind the ingress, mTLS
#       enabled: false
#       host: sync-source.<domain>
#       dsn_secret: { name: postgis1-datasets-readonly-connection-string, key: connection-string }
#                                       # the read-only role (postgres-db `datasets_ro`); any
#                                       # Postgres URL works, the tool picks its own driver
#       allow_schemas: []               # required: the only schemas it reads
#       allow_source_ranges: ""         # optional: the developers' egress CIDRs
#       ingress_namespace: ingress      # where the ingress controller runs (NetworkPolicy)
#       client_certs: true              # false: server TLS only, for a host reachable only
#                                       # from a private network (the network is the gate)
#       auth_limits: {}                 # optional: failMax, failWindow, lockout, failGlobalMax
#       tokens: {}                      # secret: {holder: token}, one per developer
#       ca: ""                          # secret: PEM, the pull CA, with client_certs; never
#                                       # the push CA
#       server_cert: ""                 # secret: PEM, the serving host's certificate (pull CA)
#       server_key: ""                  # secret: PEM
#       resources: {}
#
# The CAs, certificates and tokens come from `sync-tables certs` (one CA per purpose). The IngressClass follows
# `ingress_controller.class` (default nginx), as for every other release.
{{- $st := .Environment.Values | dig "sync_tables" (dict) }}
{{- $sink := $st | dig "sink" (dict) }}
{{- $push := $st | dig "push_source" (dict) }}
{{- $serve := $st | dig "serve" (dict) }}

image: {{ $st | dig "image" "" | quote }}
imagePullSecrets:
  - name: registry-secrets

sink:
  enabled: {{ $sink | dig "enabled" false }}
  ingressClassName: {{ .Values | dig "ingress_controller" "class" "nginx" | quote }}
  host: {{ $sink | dig "host" (printf "sync.%s" (.Environment.Values | dig "domain" "")) | quote }}
  ingressFlavor: {{ $sink | dig "ingress_flavor" "" | quote }}
  dsnSecret: {{ $sink | dig "dsn_secret" (dict "name" "" "key" "connection-string") | toJson }}
  allowSchemas: {{ $sink | dig "allow_schemas" (list) | toJson }}
  allowSourceRanges: {{ $sink | dig "allow_source_ranges" "" | quote }}
  authLimits: {{ $sink | dig "auth_limits" (dict) | toJson }}
  tokens: {{ $sink | dig "tokens" (dict) | toJson }}
  token: {{ $sink | dig "token" "" | quote }}
  ca: {{ $sink | dig "ca" "" | toJson }}
  serverCert: {{ $sink | dig "server_cert" "" | toJson }}
  serverKey: {{ $sink | dig "server_key" "" | toJson }}
  resources: {{ $sink | dig "resources" (dict) | toJson }}
  podAnnotations: {{ $sink | dig "pod_annotations" (dict) | toJson }}
  podDisruptionBudget:
    enabled: {{ $sink | dig "pdb" false }}
  networkPolicy:
    ingressNamespace: {{ $sink | dig "ingress_namespace" "ingress" | quote }}

serve:
  enabled: {{ $serve | dig "enabled" false }}
  ingressClassName: {{ .Values | dig "ingress_controller" "class" "nginx" | quote }}
  host: {{ $serve | dig "host" (printf "sync-source.%s" (.Environment.Values | dig "domain" "")) | quote }}
  dsnSecret: {{ $serve | dig "dsn_secret" (dict "name" "postgis1-datasets-readonly-connection-string" "key" "connection-string") | toJson }}
  allowSchemas: {{ $serve | dig "allow_schemas" (list) | toJson }}
  allowSourceRanges: {{ $serve | dig "allow_source_ranges" "" | quote }}
  clientCerts: {{ $serve | dig "client_certs" true }}
  {{- with $serve | dig "auth_limits" nil }}
  authLimits: {{ . | toJson }}
  {{- end }}
  tokens: {{ $serve | dig "tokens" (dict) | toJson }}
  token: {{ $serve | dig "token" "" | quote }}
  ca: {{ $serve | dig "ca" "" | toJson }}
  serverCert: {{ $serve | dig "server_cert" "" | toJson }}
  serverKey: {{ $serve | dig "server_key" "" | toJson }}
  resources: {{ $serve | dig "resources" (dict) | toJson }}
  networkPolicy:
    ingressNamespace: {{ $serve | dig "ingress_namespace" "ingress" | quote }}

pushSource:
  enabled: {{ $push | dig "enabled" false }}
  schedule: {{ $push | dig "schedule" "*/30 * * * *" | quote }}
  sinkUrl: {{ $push | dig "sink_url" "" | quote }}
  sourceSecret: {{ $push | dig "source_secret" (dict "name" "postgis1-datasets-connection-string" "key" "connection-string") | toJson }}
  profile: {{ $push | dig "profile" "" | toJson }}
  token: {{ $push | dig "token" "" | quote }}
  ca: {{ $push | dig "ca" "" | toJson }}
  clientCert: {{ $push | dig "client_cert" "" | toJson }}
  clientKey: {{ $push | dig "client_key" "" | toJson }}
  resources: {{ $push | dig "resources" (dict) | toJson }}
