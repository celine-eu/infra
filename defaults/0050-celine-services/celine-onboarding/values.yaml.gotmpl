# defaults/0050-celine-services/celine-onboarding/values.yaml.gotmpl
#
# The onboarding API. Installed only where `onboarding.enabled` is true
# (helmfile.d/0050-celine-services.yaml.gotmpl). Environment keys:
#
#   onboarding:
#     enabled: false
#     image_tag: latest
#     host: onboarding.<domain>          # also the UI's (celine-frontend-onboarding)
#     forwarded_allow_ips: 0.0.0.0       # the ingress controller's pod range (set it in secrets.yaml).
#                                        # The default trusts no proxy (no peer is 0.0.0.0): every
#                                        # caller shares the ingress's address. Never "*" or a /0.
#     encryption_key: ""                 # REQUIRED, secret: a Fernet key
#     client_secret: svc-onboarding      # secret; the same key policies-shell syncs to the realm
#     cli_client_secret: svc-onboarding-cli   # secret; likewise
#     dataspace_enabled: false
#     sms_provider: none                 # none: no phone verification; brevo needs dpa_sms_signed
#     dpa_sms_signed: false
#     brevo_sms_sender: ""
#     brevo_api_key: ""                  # secret, with sms_provider: brevo
#     otp_hmac_key: ""                   # secret: OTP_HMAC_KEY, keys the OTP hashes. REQUIRED while
#                                        # phone verification is on (sms_provider log, console or
#                                        # dev, or brevo with dpa_sms_signed): a random secret of
#                                        # its own, never encryption_key or rec_assertion_hmac_key
#     extraction_enabled: false          # read bills and identity documents with a vision model;
#                                        # on only with llm.base_url and llm.vision_model too.
#                                        # Uploads need persistence
#     id_document_enabled: true          # false: no identity-document upload or scan for any
#                                        # community (ID_DOCUMENT_ENABLED); true leaves it to each
#                                        # template's `id_document.enabled`. The bill is unaffected
#     llm:                               # an OpenAI-compatible endpoint (as ai_assistant.llm)
#       base_url: ""
#       vision_model: ""
#       api_key: ""                      # secret, if the endpoint needs one: reaches the pod
#                                        # from the release's Secret, never as a plain value
#       thinking: ""                     # LLM_THINKING, e.g. "false": skip the model's reasoning
#                                        # phase. Empty: not set
#     smtp: {}                           # overrides the shared `smtp` block (README "Email (SMTP)")
#     templates:
#       files: {}                        # <slug>/<path> → text
#       binary_files: {}                 # <slug>/<path> → base64
#     persistence: {enabled: false, size: 1Gi, storage_class: ""}
#     env: {}                            # further plain settings, NAME: value
#     resources: {}
#
# and `postgres_db.onboarding`, the database role's password (secret), which
# postgres-db reads only when onboarding is enabled.
#
# The add-on layer (README, "Add-on layer") turns the dataspace on as well:
# with `dataspace.enabled` (and `dataspace.onboarding.enabled`, true unless set
# false), DATASPACE_ENABLED is true whatever `onboarding.dataspace_enabled` says,
# and these become mandatory while onboarding is enabled:
#
#   dataspace:
#     onboarding:
#       identity_registry_url: http://…   # REQUIRED: IDENTITY_REGISTRY_URL
#       connector_url: ""                 # DS_CONNECTOR_URL when set
#       collector_aliases: []             # SVC_DS_COLLECTOR_<ALIAS>_SECRET each
#       template_patches: {}              # <slug>/<path> → a map deep-merged into
#                                         # templates.files[<path>] (which must exist)
#     client_secrets:                     # secret
#       svc-ds-onboarding: …              # REQUIRED: DS_ONBOARDING_CLIENT_SECRET
#       svc-ds-collector-<alias>: …       # REQUIRED for each collector alias
#
#   onboarding:
#     rec_assertion_hmac_key: …           # REQUIRED, secret: REC_ASSERTION_HMAC_KEY
{{- $o := .Environment.Values | dig "onboarding" (dict) | default (dict) }}
{{- $ds := .Environment.Values | dig "dataspace" (dict) | default (dict) }}
{{- $dsOn := $ds | dig "enabled" false }}
{{- if not (kindIs "bool" $dsOn) }}
{{- fail (printf "dataspace.enabled must be true or false, got %v" $dsOn) }}
{{- end }}
{{- $dsO := $ds | dig "onboarding" (dict) | default (dict) }}
{{- $dsOEnabled := $dsO | dig "enabled" true }}
{{- if not (kindIs "bool" $dsOEnabled) }}
{{- fail (printf "dataspace.onboarding.enabled must be true or false, got %v" $dsOEnabled) }}
{{- end }}
{{- /* The dataspace side of onboarding, from the add-on layer. Its inputs are checked only
       where onboarding is on: values files render at group load (see the SMTP check below). */}}
{{- $dsOnboarding := and $dsOn $dsOEnabled }}
{{- $dsCheck := and $dsOnboarding ($o | dig "enabled" false) }}
{{- $dsSecrets := $ds | dig "client_secrets" (dict) | default (dict) }}
{{- $dsCollectorSecrets := dict }}
{{- $templateFiles := $o | dig "templates" "files" (dict) | default (dict) }}
{{- if $dsCheck }}
{{- if not ($dsO | dig "identity_registry_url" "") }}
{{- fail "dataspace.enabled is true: dataspace.onboarding.identity_registry_url is required (onboarding's IDENTITY_REGISTRY_URL), or set dataspace.onboarding.enabled: false" }}
{{- end }}
{{- if not (index $dsSecrets "svc-ds-onboarding") }}
{{- fail "dataspace.enabled is true: dataspace.client_secrets.svc-ds-onboarding is required in the environment's secrets (onboarding's DS_ONBOARDING_CLIENT_SECRET)" }}
{{- end }}
{{- if not ($o | dig "rec_assertion_hmac_key" "") }}
{{- fail "dataspace.enabled is true: onboarding.rec_assertion_hmac_key is required in the environment's secrets (onboarding's REC_ASSERTION_HMAC_KEY)" }}
{{- end }}
{{- $aliases := $dsO | dig "collector_aliases" list }}
{{- if not (kindIs "slice" $aliases) }}
{{- fail "dataspace.onboarding.collector_aliases must be a list of collector aliases" }}
{{- end }}
{{- range $aliases }}
{{- $key := printf "svc-ds-collector-%v" . }}
{{- if not (index $dsSecrets $key) }}
{{- fail (printf "dataspace.onboarding.collector_aliases lists %v: dataspace.client_secrets.%s is required in the environment's secrets" . $key) }}
{{- end }}
{{- $_ := set $dsCollectorSecrets (toString .) (index $dsSecrets $key | toString) }}
{{- end }}
{{- $patches := $dsO | dig "template_patches" (dict) | default (dict) }}
{{- if not (kindIs "map" $patches) }}
{{- fail "dataspace.onboarding.template_patches must be a map of template path to patch" }}
{{- end }}
{{- if $patches }}
{{- $templateFiles = deepCopy $templateFiles }}
{{- range $path, $patch := $patches }}
{{- if not (hasKey $templateFiles $path) }}
{{- fail (printf "dataspace.onboarding.template_patches: %s is not in onboarding.templates.files, so there is nothing to patch" $path) }}
{{- end }}
{{- if not (kindIs "map" $patch) }}
{{- fail (printf "dataspace.onboarding.template_patches.%s must be a map, deep-merged into the template" $path) }}
{{- end }}
{{- $doc := index $templateFiles $path | fromYaml | default (dict) }}
{{- $_ := set $templateFiles $path (mergeOverwrite $doc (deepCopy $patch) | toYaml) }}
{{- end }}
{{- end }}
{{- end }}
{{- $host := $o | dig "host" (printf "onboarding.%s" .Values.domain) }}
{{- /* Unset or empty: 0.0.0.0, which no peer is, so no proxy is trusted. The chart
       refuses "*" and /0 (celine-onboarding.validate). */}}
{{- $ips := $o | dig "forwarded_allow_ips" "" | toString | trim | default "0.0.0.0" }}

# SMTP: the environment's shared `smtp` block, unless `onboarding.smtp.host` is
# set, in which case `onboarding.smtp` is the provider as a whole. The sender
# falls back to `smtp.from`. Onboarding speaks STARTTLS or plain SMTP only.
{{- $smtpShared := .Environment.Values | dig "smtp" (dict) | default (dict) }}
{{- $smtpOwn := $o | dig "smtp" (dict) | default (dict) }}
{{- $smtp := $smtpShared }}
{{- if $smtpOwn | dig "host" "" }}
{{- $smtp = $smtpOwn }}
{{- end }}
{{- /* Only where onboarding is on: values files render at group load, so an
       unconditional fail here would stop every celine-services release. */}}
{{- if and ($o | dig "enabled" false) ($smtp | dig "host" "") ($smtp | dig "ssl" false) }}
{{- fail "onboarding: the resolved SMTP block has ssl: true; onboarding has no implicit-TLS mode. Use STARTTLS (ssl: false, starttls: true, usually port 587) or set onboarding.smtp" }}
{{- end }}

{{- /* OTP_HMAC_KEY: onboarding refuses to start without it while phone verification is on
       (its posture guard; the rule is onboarding's `phone_verification_enabled`, the same as
       the legal defaults' sms_verification), or when it equals an ENCRYPTION_KEY key. Caught
       here so a diff fails before an apply. Only where onboarding is on (group load). */}}
{{- $otpKey := $o | dig "otp_hmac_key" "" | toString | trim }}
{{- if $o | dig "enabled" false }}
{{- $smsName := $o | dig "sms_provider" "none" | toString | lower | trim }}
{{- $phoneOn := or (has $smsName (list "log" "console" "dev")) (and (eq $smsName "brevo") (eq (toString ($o | dig "dpa_sms_signed" false)) "true")) }}
{{- if and $phoneOn (not $otpKey) }}
{{- fail (printf "onboarding: phone verification is on (sms_provider %s): onboarding.otp_hmac_key is required in the environment's secrets (onboarding's OTP_HMAC_KEY), a random secret of its own" $smsName) }}
{{- end }}
{{- if $otpKey }}
{{- $encKeys := list }}
{{- range splitList "," ($o | dig "encryption_key" "" | toString) }}{{- $encKeys = append $encKeys (trim .) }}{{- end }}
{{- if or (has $otpKey $encKeys) (eq $otpKey ($o | dig "rec_assertion_hmac_key" "" | toString | trim)) }}
{{- fail "onboarding.otp_hmac_key must be a secret of its own: it equals onboarding.encryption_key (one of its keys) or onboarding.rec_assertion_hmac_key" }}
{{- end }}
{{- end }}
{{- end }}

image:
  tag: {{ $o | dig "image_tag" "latest" | quote }}

oidc:
  service:
    clientSecret: {{ $o | dig "client_secret" "svc-onboarding" | quote }}

healthCheck:
  path: /api/health

onboarding:
  forwardedAllowIps: {{ $ips | quote }}
  encryptionKey: {{ $o | dig "encryption_key" "" | quote }}
  {{- /* Onboarding's effective dataspace switch: it collects the data-release consent. The
         legal defaults (dso_data_exchange) and the webapp's (DATA_SHARING_ENABLED) derive
         from the same expression: keep the three in step. */}}
  dataspaceEnabled: {{ or (eq (toString ($o | dig "dataspace_enabled" false)) "true") $dsOnboarding }}
  {{- if $dsCheck }}
  identityRegistryUrl: {{ $dsO | dig "identity_registry_url" "" | quote }}
  dsOnboardingClientSecret: {{ index $dsSecrets "svc-ds-onboarding" | toString | quote }}
  recAssertionHmacKey: {{ $o | dig "rec_assertion_hmac_key" "" | toString | quote }}
  {{- with $dsO | dig "connector_url" "" }}
  dsConnectorUrl: {{ . | quote }}
  {{- end }}
  {{- with $dsCollectorSecrets }}
  dsCollectorSecrets:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  {{- end }}
  cliClientSecret: {{ $o | dig "cli_client_secret" "svc-onboarding-cli" | quote }}
  corsOrigins: {{ printf "https://%s" $host | quote }}
  smsProvider: {{ $o | dig "sms_provider" "none" | quote }}
  dpaSmsSigned: {{ $o | dig "dpa_sms_signed" false }}
  brevoSmsSender: {{ $o | dig "brevo_sms_sender" "" | quote }}
  brevoApiKey: {{ $o | dig "brevo_api_key" "" | quote }}
  {{- with $o | dig "otp_hmac_key" "" | toString }}
  otpHmacKey: {{ . | quote }}
  {{- end }}
  extractionEnabled: {{ eq (toString ($o | dig "extraction_enabled" false)) "true" }}
  idDocumentEnabled: {{ ne (toString ($o | dig "id_document_enabled" true)) "false" }}
  llm:
    baseUrl: {{ $o | dig "llm" "base_url" "" | quote }}
    visionModel: {{ $o | dig "llm" "vision_model" "" | quote }}
    apiKey: {{ $o | dig "llm" "api_key" "" | quote }}
    thinking: {{ $o | dig "llm" "thinking" "" | toString | quote }}
  smtp:
    host: {{ $smtp | dig "host" "" | quote }}
    port: {{ $smtp | dig "port" 587 }}
    user: {{ $smtp | dig "user" "" | quote }}
    password: {{ $smtp | dig "password" "" | quote }}
    from: {{ $smtpOwn | dig "from" "" | default ($smtpShared | dig "from" "") | quote }}
    tls: {{ $smtp | dig "starttls" true }}
    notify: {{ $smtpOwn | dig "notify" "" | quote }}

templates:
  files:
    {{- $templateFiles | toYaml | nindent 4 }}
  binaryFiles:
    {{- $o | dig "templates" "binary_files" (dict) | default (dict) | toYaml | nindent 4 }}

persistence:
  enabled: {{ $o | dig "persistence" "enabled" false }}
  size: {{ $o | dig "persistence" "size" "1Gi" | quote }}
  storageClass: {{ $o | dig "persistence" "storage_class" "" | quote }}

{{- /* The legal host's base URL: `legal.base_url`, else https://<legal host> when the
       release is installed, else none (see celine-legal's defaults). */}}
{{- $legal := .Environment.Values | dig "legal" (dict) | default (dict) }}
{{- $legalHost := $legal | dig "host" (printf "legal.%s" .Environment.Values.domain) }}
{{- $legalBase := $legal | dig "base_url" (ternary (printf "https://%s" $legalHost) "" ($legal | dig "enabled" false)) | trimSuffix "/" }}
{{- $onboardingEnv := $o | dig "env" (dict) | default (dict) }}
{{- if or $onboardingEnv $legalBase }}
extraEnv:
  {{- with $legalBase }}
  # Consent documents resolved per community (onboarding `services/legal_documents.py`).
  - name: LEGAL_BASE_URL
    value: {{ . | quote }}
  {{- end }}
  {{- range $name, $value := $onboardingEnv }}
  - name: {{ $name }}
    value: {{ $value | toString | quote }}
  {{- end }}
{{- end }}

{{- with $o | dig "resources" nil }}
resources:
  {{- toYaml . | nindent 2 }}
{{- end }}
