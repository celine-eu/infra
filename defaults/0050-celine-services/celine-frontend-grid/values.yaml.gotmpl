# defaults/0050-celine-services/celine-frontend-grid/values.yaml.gotmpl

image:
  tag: {{ .Environment.Values.frontend_grid.image_tag | default "latest" | quote }}

ingress:
  host: grid.{{ .Environment.Values.domain }}
  domain: {{ .Environment.Values.domain }}

# IngressClass of every Ingress (`ingress_controller.class`, default nginx).
ingressClassName: {{ .Values | dig "ingress_controller" "class" "nginx" | quote }}
