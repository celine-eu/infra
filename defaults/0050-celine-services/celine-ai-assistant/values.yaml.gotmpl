image:
  tag: {{ .Environment.Values.ai_assistant.image_tag | default "latest" | quote }}

oidc:
  service:
    # skip client ID / secrets
    passthrough: true
    clientId: ""
    audience: "oauth2_proxy"
    clientSecret: ""

  includeClientIdAsAudience: false
  allowedAudiences: ""

{{- $qdrantApiKey := .Environment.Values | dig "qdrant" "api_key" "" }}

extraEnv:
  # Token verification. The issuer is the realm oauth2-proxy signs users in with (Keycloak's
  # KC_HOSTNAME fixes every token's `iss` to it); the key set comes from CELINE_OIDC_JWKS_URI,
  # set by celine-services, or from the issuer's discovery on images that do not read it.
  # The audience is the edge client user tokens are issued to. Header trust is off: every
  # caller presents a verified token (refused at startup outside CELINE_ENV=dev anyway).
  - name: OAUTH2_ISSUER
    value: {{ printf "https://keycloak.%s/realms/%s" .Environment.Values.domain (.Environment.Values | dig "keycloak" "realm" "celine") | quote }}
  - name: OAUTH2_AUDIENCE
    value: {{ .Environment.Values | dig "auth_setup" "clientID" "oauth2_proxy" | quote }}
  - name: OAUTH2_TRUST_HEADERS
    value: "false"
  - name: QDRANT_URL
    value: http://qdrant:6333
  {{- if $qdrantApiKey }}
  # Qdrant's API key (`qdrant.api_key`, the same value the qdrant release enforces).
  # Required by the assistant outside CELINE_ENV=dev.
  - name: QDRANT_API_KEY
    valueFrom:
      secretKeyRef:
        name: ai-assistant-secrets
        key: QDRANT_API_KEY
  {{- end }}
  {{- $llm := .Environment.Values | dig "ai_assistant" "llm" dict }}
  # Where members' messages and the data the tools fetch for them are sent. No default:
  # the assistant refuses to start without a base URL and the two models.
  - name: LLM_BASE_URL
    value: {{ $llm | dig "base_url" "" | quote }}
  - name: LLM_API_KEY
    value: {{ $llm | dig "api_key" "" | quote }}
  - name: LLM_CHAT_MODEL
    value: {{ $llm | dig "chat_model" "" | quote }}
  - name: LLM_VISION_MODEL
    value: {{ $llm | dig "vision_model" "" | quote }}
  - name: LLM_EMBED_BASE_URL
    value: {{ $llm | dig "embed_base_url" "" | quote }}
  - name: LLM_EMBED_API_KEY
    value: {{ $llm | dig "embed_api_key" "" | quote }}
  - name: LLM_EMBED_MODEL
    value: {{ $llm | dig "embed_model" "" | quote }}
  - name: LLM_EMBED_DIMENSIONS
    value: {{ $llm | dig "embed_dimensions" "" | quote }}
  # A prefix: each REC's knowledge base is the Qdrant alias
  # <prefix>__<community_id>__<embedding fingerprint> (the assistant's ADR-0008).
  - name: QDRANT_COLLECTION
    value: {{ .Environment.Values | dig "ai_assistant" "qdrant_collection" "celine_docs" | quote }}
  {{- $kb := .Environment.Values | dig "ai_assistant" "kb" dict }}
  # Knowledge sources are registered per REC with `celine-assistant kb source add`;
  # git sources are cloned onto the data volume.
  - name: KB_SOURCES_DIR
    value: "/app/data/kb-sources"
  - name: KB_SYNC_ON_START
    value: {{ $kb | dig "sync_on_start" false | toString | quote }}
  - name: KB_GIT_TOKEN_HOST
    value: {{ $kb | dig "git_token_host" "github.com" | quote }}
  {{- if $kb | dig "git_token" "" }}
  - name: KB_GIT_TOKEN
    valueFrom:
      secretKeyRef:
        name: ai-assistant-secrets
        key: KB_GIT_TOKEN
  {{- end }}
  # The organization type that marks a REC in the token; the same value onboarding uses.
  - name: REC_ORGANIZATION_TYPE
    value: {{ .Environment.Values | dig "ai_assistant" "rec_organization_type" "rec" | quote }}
  - name: DIGITAL_TWIN_API_URL
    value: "http://digital-twin:8002"
  - name: DATASETS_API_URL
    value: "http://dataset-api:8001"
  - name: REC_REGISTRY_API_URL
    value: "http://rec-registry:8004"
  - name: FLEXIBILITY_API_URL
    value: "http://flexibility-api:8017"

{{- if or ($kb | dig "git_token" "") $qdrantApiKey }}

# Keep these out of the Deployment spec: a token for private knowledge sources, Qdrant's key.
extraSecrets:
  {{- with $kb | dig "git_token" "" }}
  KB_GIT_TOKEN: {{ . | quote }}
  {{- end }}
  {{- with $qdrantApiKey }}
  QDRANT_API_KEY: {{ . | quote }}
  {{- end }}
{{- end }}

{{- with .Environment.Values | dig "ai_assistant" "resources" nil }}
resources:
  {{- toYaml . | nindent 2 }}
{{- end }}