domain: {{ .Values.domain }}
issuer: {{ .Values.tls_setup.issuer | default "celine-tls" }}

# TLS on api.<domain> in every environment, like every other service ingress (the issuer
# is self-signed in dev, ACME elsewhere).
tls:
  enabled: true

# IngressClass of every Ingress (`ingress_controller.class`, default nginx).
ingressClassName: {{ .Values | dig "ingress_controller" "class" "nginx" | quote }}
