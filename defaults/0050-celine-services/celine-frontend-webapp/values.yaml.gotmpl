# defaults/0050-celine-services/celine-frontend-webapp/values.yaml.gotmpl

image:
  tag: {{ .Environment.Values.frontend_webapp.image_tag | default "latest" | quote }}

ingress:
  host: webapp.{{ .Environment.Values.domain }}
  domain: {{ .Environment.Values.domain }}

# The development-version banner (celine-frontend `EnvBanner`): PUBLIC_CELINE_ENV is
# CELINE_ENV's value (`celine_env`, else the environment's name); outside prod,
# PUBLIC_CELINE_PROD_URL is this host on prod's domain (`prod_reads.domain`), the banner's link.
{{- $celineEnv := .Values | dig "celine_env" .Environment.Name | toString }}
{{- $prodDomain := .Values | dig "prod_reads" "domain" "" | toString }}
extraEnv:
  - name: PUBLIC_CELINE_ENV
    value: {{ $celineEnv | quote }}
  {{- if and $prodDomain (ne ($celineEnv | trim | lower) "prod") }}
  - name: PUBLIC_CELINE_PROD_URL
    value: {{ printf "https://webapp.%s" $prodDomain | quote }}
  {{- end }}

# IngressClass of every Ingress (`ingress_controller.class`, default nginx).
ingressClassName: {{ .Values | dig "ingress_controller" "class" "nginx" | quote }}

# Images pinned by digest where the environment lists them (`image_digests`,
# {repository: {tag: sha256:…}}; celine-services.imageRef). Empty: images by tag.
imageDigests: {{ .Values | dig "image_digests" (dict) | toJson }}
