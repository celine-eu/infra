# defaults/0050-celine-services/celine-legal/values.yaml.gotmpl
#
# The legal host (ghcr.io/celine-eu/celine-legal). Installed only where `legal.enabled` is
# true. Environment keys:
#
#   legal:
#     enabled: false          # install the release
#     image_tag: ""           # required: a released celine-legal version, vX.Y.Z
#     host: legal.<domain>    # the public host
#     draft: false            # serve the draft for review at /draft/<revision>/
#     draft_alias: ""         # /draft/<alias>/ redirects to the current draft; empty: the
#                             # image's default, `latest`, which anyone can guess
#     release: ""             # pin the stable site to vX.Y.Z (refused unless the newest published)
#     features: {}            # name -> true/false: overrides what is derived below
#                             # (existing_members only on an image that knows it, see below)
#     base_url: ""            # where applications find the legal host; default https://<host>
#                             # when enabled. Set it alone to use a legal host served elsewhere;
#                             # set it to "" to keep the applications off this host while it
#                             # only serves a draft (nothing published yet).
#     applications_read_draft: false  # the applications read the draft instead of the root:
#                             # https://<host>/draft/<draft_revision>. Needs enabled and draft.
#                             # For an environment that reviews the texts in the applications
#                             # themselves (acceptances are then given on draft versions)
#     draft_revision: ""      # the draft's 40-hex commit, the same `draft.revision` the release's
#                             # environment file gives the host; required by applications_read_draft
#     resources: {}
#
# The deployment's legal data (`data.files`) and the draft's revision (`draft.revision`) come
# from the release's own environment file, envs/<env>/0050-celine-services/celine-legal/
# values.yaml.gotmpl, which belongs to the deployment.
#
# **The features follow the applications' switches**, so a text never describes what this
# environment does not run (celine-legal templates/features.yaml):
#   sms_verification     onboarding.sms_provider a dev provider (log, console, dev), or brevo
#                        with onboarding.dpa_sms_signed
#   document_extraction  onboarding.extraction_enabled with llm.base_url and llm.vision_model;
#                        onboarding.env EXTRACTION_ENABLED, LLM_BASE_URL, LLM_VISION_MODEL win
#                        where set, as they do in the pod (upload follows the same switch)
#   dso_data_exchange    where consent to release data to the dataspace is collected: onboarding's
#                        effective DATASPACE_ENABLED (onboarding.dataspace_enabled, or the add-on
#                        layer's dataspace.enabled with dataspace.onboarding.enabled, true unless
#                        set false), or an explicit webapp.data_sharing_enabled: true (its page
#                        grants as well as withdraws). The webapp's page defaults to onboarding's
#                        switch, so by default both follow the place that collects the consent,
#                        and webapp.data_sharing_enabled: false never turns the texts off while
#                        onboarding still collects. The same expression is in the onboarding
#                        and webapp defaults: keep the three in step
#   ai_assistant         true: the assistant has no switch, it is released with the services
#   existing_members     any onboarding template (`onboarding.templates.files`, <slug>/manifest.yaml)
#                        with existing_members.enabled, after the add-on layer's template_patches.
#                        Deployment-wide: one such template puts the passage in every community's
#                        notice. Only for a legal image that knows it, image_tag vX.Y.Z from
#                        v0.2.0 on: an older image's draft refuses a feature it does not know,
#                        so nothing is set for it there, and setting it in `features` fails here
# All but ai_assistant are off where onboarding is not installed, dso_data_exchange
# included unless webapp.data_sharing_enabled is true (a webapp reaching an onboarding elsewhere).
#
# The same base URL reaches celine-webapp and celine-onboarding (`LEGAL_BASE_URL`), the
# standalone assistant (`PUBLIC_LEGAL_BASE_URL`) and Keycloak's theme (`TERMS_URL`,
# `PRIVACY_URL`), each computed the same way in its own defaults file. It is the host's root,
# the published releases, unless `applications_read_draft` points them all at the draft. The
# draft's address changes with its revision: after a change to the data, apply `legal` first,
# then the applications.
{{- $legal := .Environment.Values | dig "legal" (dict) | default (dict) }}
{{- $o := .Environment.Values | dig "onboarding" (dict) | default (dict) }}
{{- $oe := $o | dig "env" (dict) | default (dict) }}
{{- $onboarding := $o | dig "enabled" false }}
{{- $sms := $o | dig "sms_provider" "none" | toString | lower | trim }}
{{- $smsOn := or (has $sms (list "log" "console" "dev")) (and (eq $sms "brevo") (eq (toString ($o | dig "dpa_sms_signed" false)) "true")) }}
{{- /* onboarding.env comes after the chart's own variables (extraEnv), so it wins. */}}
{{- $exFlag := ternary ($oe | dig "EXTRACTION_ENABLED" "") ($o | dig "extraction_enabled" false) (hasKey $oe "EXTRACTION_ENABLED") }}
{{- $llmUrl := $oe | dig "LLM_BASE_URL" "" | default ($o | dig "llm" "base_url" "") }}
{{- $llmModel := $oe | dig "LLM_VISION_MODEL" "" | default ($o | dig "llm" "vision_model" "") }}
{{- $extractionOn := and (eq (toString $exFlag | lower) "true") $llmUrl $llmModel }}
{{- /* The add-on layer's onboarding side (celine-onboarding defaults). */}}
{{- $ds := .Environment.Values | dig "dataspace" (dict) | default (dict) }}
{{- $dsOnboarding := and (eq (toString ($ds | dig "enabled" false)) "true") (eq (toString ($ds | dig "onboarding" "enabled" true)) "true") }}
{{- /* dso_data_exchange: onboarding's effective DATASPACE_ENABLED, as the onboarding defaults
       decide it, or the webapp's data-sharing page set on explicitly (the webapp defaults
       give it onboarding's switch otherwise). Keep in step with both files. */}}
{{- $dsCollect := and (eq (toString $onboarding) "true") (or (eq (toString ($o | dig "dataspace_enabled" false)) "true") $dsOnboarding) }}
{{- $webappSharing := eq (toString (.Environment.Values | dig "webapp" "data_sharing_enabled" false) | lower) "true" }}
{{- /* existing_members: as onboarding reads the templates, with the add-on layer's patches
       deep-merged where its onboarding side is on. */}}
{{- $patches := $ds | dig "onboarding" "template_patches" (dict) | default (dict) }}
{{- $existingOn := false }}
{{- range $path, $text := ($o | dig "templates" "files" (dict) | default (dict)) }}
{{- if eq (base $path) "manifest.yaml" }}
{{- $doc := $text | toString | fromYaml | default (dict) }}
{{- if and $dsOnboarding (kindIs "map" (index $patches $path)) }}
{{- $doc = mergeOverwrite (deepCopy $doc) (deepCopy (index $patches $path)) }}
{{- end }}
{{- if eq (toString ($doc | dig "existing_members" "enabled" false)) "true" }}
{{- $existingOn = true }}
{{- end }}
{{- end }}
{{- end }}
{{- /* The first celine-legal release whose templates know existing_members. */}}
{{- $existingMembersSince := "0.2.0" }}
{{- $tag := $legal | dig "image_tag" "" | toString }}
{{- $knowsExisting := and (regexMatch "^v[0-9]+[.][0-9]+[.][0-9]+$" $tag) (semverCompare (printf ">=%s" $existingMembersSince) (trimPrefix "v" $tag)) }}
{{- $explicit := $legal | dig "features" (dict) | default (dict) }}
{{- if and (hasKey $explicit "existing_members") (not $knowsExisting) }}
{{- fail (printf "legal.features.existing_members: legal.image_tag %q does not know this feature, and its draft would refuse it; it needs celine-legal v%s or later" $tag $existingMembersSince) }}
{{- end }}
{{- $derived := dict
      "sms_verification" (and $onboarding $smsOn)
      "document_extraction" (and $onboarding (not (empty $extractionOn)))
      "dso_data_exchange" (or $dsCollect $webappSharing)
      "ai_assistant" true }}
{{- if $knowsExisting }}
{{- $_ := set $derived "existing_members" (and $onboarding $existingOn) }}
{{- end }}

image:
  tag: {{ $legal | dig "image_tag" "" | quote }}

draft:
  enabled: {{ $legal | dig "draft" false }}
  alias: {{ $legal | dig "draft_alias" "" | quote }}

release: {{ $legal | dig "release" "" | quote }}

{{- /* An explicit value wins, false included: sprig's merge treats false as empty and would
       fill it from $derived. */}}
{{- $features := deepCopy $derived }}
{{- range $name, $on := $explicit }}
{{- $_ := set $features $name $on }}
{{- end }}

features:
  {{- range $name, $on := $features }}
  {{ $name }}: {{ if $on }}true{{ else }}false{{ end }}
  {{- end }}

ingress:
  host: {{ $legal | dig "host" (printf "legal.%s" .Environment.Values.domain) }}
  issuer: {{ .Environment.Values | dig "tls_setup" "issuer" "celine-tls" }}

{{- with $legal | dig "resources" nil }}
resources:
  {{- toYaml . | nindent 2 }}
{{- end }}

# IngressClass of every Ingress (`ingress_controller.class`, default nginx).
ingressClassName: {{ .Values | dig "ingress_controller" "class" "nginx" | quote }}
