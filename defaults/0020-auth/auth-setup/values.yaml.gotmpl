secure: true

realm: {{ .Environment.Values | dig "keycloak" "realm" "celine" | quote }}
domain: "{{ .Environment.Values.domain }}"
# oauth2-proxy's issuer: `keycloak.public_url` (by default https://keycloak.<domain>) and the realm.
keycloakUrl: {{ .Environment.Values | dig "keycloak" "public_url" (printf "https://keycloak.%s" .Environment.Values.domain) | quote }}
# What only the in-namespace Keycloak release uses (realm import, its response headers):
# off with `keycloak.enabled: false`, where the environment's realm lives on a shared instance.
localKeycloak: {{ .Environment.Values | dig "keycloak" "enabled" true }}
issuer: {{ .Environment.Values.tls_setup.issuer }}
# IngressClass of every Ingress (`ingress_controller.class`, default nginx).
ingressClassName: {{ .Values | dig "ingress_controller" "class" "nginx" | quote }}

realmAdmin:
  username: {{ .Environment.Values | dig "auth_setup" "realmAdminUser" "celine-admin" }}
  email: {{ .Environment.Values | dig "auth_setup" "realmAdminEmail" "admin@celine.test" }}
  password: {{ .Environment.Values | dig "auth_setup" "realmAdminPassword" "celine-admin" }}

oauth2Proxy:
  clientID: {{ .Environment.Values.auth_setup.clientID | default "oauth2_proxy"  }}
  # openssl rand -hex 16
  clientSecret: {{ .Environment.Values.auth_setup.clientSecret }}
  cookieSecret: {{ .Environment.Values.auth_setup.cookieSecret }}
  # `auth_setup.allowed_groups`: only these groups pass the whole proxy (oauth2-proxy
  # `allowed_groups`; realm roles are `role:<name>`), for an environment whose sso fronts
  # admin UIs only. Unset: every signed-in user passes, as before.
  allowedGroups: {{ .Environment.Values | dig "auth_setup" "allowed_groups" list | toJson }}
  {{- /* `ingress_controller.annotations: traefik`: the admin UIs' forwardAuth address is the
         proxy's root (defaults/0020-auth/oauth2-proxy), so a session must answer 2xx there:
         static://202. Traefik treats anything else as a refusal and returns it as is. */}}
  upstreams: {{ ternary (list "static://202") (list "file:///dev/null") (eq (.Environment.Values | dig "ingress_controller" "annotations" "nginx" | toString) "traefik") | toJson }}

dashboard_enabled: {{ .Environment.Values | dig "auth_setup" "dashboard_enabled" true }}

# How the dashboard's Ingress is written (as defaults/0050-celine-services/ingress-mode.yaml.gotmpl).
{{- $icm := .Environment.Values | dig "ingress_controller" (dict) | default (dict) }}
traefik:
  enabled: {{ eq ($icm | dig "annotations" "nginx" | toString) "traefik" }}
  entrypoint: {{ $icm | dig "entrypoint" "websecure" | quote }}
  clusterIssuer: {{ .Environment.Values | dig "tls_setup" "ingress_cluster_issuer" "" | quote }}

# The Keycloak host's response headers, named by the keycloak release's custom-headers
# annotation: with every public host's (`security_headers.enabled`, off in dev only).
keycloakSecurityHeaders:
  enabled: {{ .Environment.Values | dig "security_headers" "enabled" true }}
{{- with .Environment.Values | dig "auth_setup" "dashboard_resources" nil }}
dashboard_resources: {{ toJson . }}
{{- end }}

dashboard_items:
  - name: Data Lineage (Marquez)
    host: marquez
  # The public Keycloak host serves the platform realm only; the admin console is reached
  # through a port-forward (task keycloak:forward), so the link is the account console.
  - name: Account (Keycloak)
{{- with .Environment.Values | dig "keycloak" "public_url" "" }}
    url: {{ printf "%s/realms/%s/account" . ($.Environment.Values | dig "keycloak" "realm" "celine") | quote }}
{{- else }}
    host: keycloak
    path: /realms/{{ .Environment.Values | dig "keycloak" "realm" "celine" }}/account
{{- end }}
  - name: Data Pipelines (Prefect)
    host: prefect
  # - name: Monitoring (Prometheus)
  #   host: prometheus


# SMTP: the environment's shared `smtp` block, unless `keycloak.smtp.host` is set, in
# which case `keycloak.smtp` is the provider as a whole (host, port, TLS, credentials:
# never mixed across blocks). Sender fields fall back one by one: `keycloak.smtp`, then
# `smtp`. Email is on when the chosen host is non-empty, unless
# `keycloak.smtp.enabled` is explicitly false. Import only: reaches new realms, never a
# running one.
{{- $smtpShared := .Environment.Values | dig "smtp" (dict) | default (dict) }}
{{- $smtpOwn := .Environment.Values | dig "keycloak" "smtp" (dict) | default (dict) }}
{{- $smtp := $smtpShared }}
{{- if $smtpOwn | dig "host" "" }}
{{- $smtp = $smtpOwn }}
{{- end }}
smtp:
  enabled: {{ and (ne ($smtp | dig "host" "" | toString) "") (.Environment.Values | dig "keycloak" "smtp" "enabled" true) }}
  host: {{ $smtp | dig "host" "" | quote }}
  port: {{ $smtp | dig "port" 587 }}
  from: {{ $smtpOwn | dig "from" "" | default ($smtpShared | dig "from" "") | default "noreply@celine.test" | quote }}
  fromDisplayName: {{ $smtpOwn | dig "fromDisplayName" "" | default ($smtpShared | dig "fromDisplayName" "") | default "CELINE Platform" | quote }}
  replyTo: {{ $smtpOwn | dig "replyTo" "" | default ($smtpShared | dig "replyTo" "") | quote }}
  ssl: {{ $smtp | dig "ssl" false }}
  starttls: {{ $smtp | dig "starttls" true }}
  auth: {{ $smtp | dig "auth" (ne ($smtp | dig "user" "" | toString) "") }}
  user: {{ $smtp | dig "user" "" | quote }}
  password: {{ $smtp | dig "password" "" | quote }}

bruteForce:
  enabled: {{ .Environment.Values | dig "keycloak" "brute_force" "enabled" false }}
  waitIncrementSeconds: {{ .Environment.Values | dig "keycloak" "brute_force" "waitIncrementSeconds" 60 }}
  quickLoginCheckMilliSeconds: {{ .Environment.Values | dig "keycloak" "brute_force" "quickLoginCheckMilliSeconds" 1000 }}
  minimumQuickLoginWaitSeconds: {{ .Environment.Values | dig "keycloak" "brute_force" "minimumQuickLoginWaitSeconds" 60 }}
  maxFailureWaitSeconds: {{ .Environment.Values | dig "keycloak" "brute_force" "maxFailureWaitSeconds" 900 }}
  # Keycloak's "max login failures" is `failureFactor`; no realm has a `maxLoginFailures`, and an
  # import naming one stops Keycloak from starting (measured on 26.7.3). An environment that set
  # `keycloak.brute_force.maxLoginFailures` meant this value, so it is read as the fallback. The
  # default, 5, is celine-policies' platform.yaml, which `bootstrap` applies to every realm.
  failureFactor: {{ .Environment.Values | dig "keycloak" "brute_force" "failureFactor" (.Environment.Values | dig "keycloak" "brute_force" "maxLoginFailures" 5) }}
  permanentLockout: {{ .Environment.Values | dig "keycloak" "brute_force" "permanentLockout" false }}  

theme:
  login: {{ .Environment.Values | dig "keycloak" "theme" "login" "rec" | quote }}
  account: {{ .Environment.Values | dig "keycloak" "theme" "account" "" | quote }}
  email: {{ .Environment.Values | dig "keycloak" "theme" "email" "" | quote }}