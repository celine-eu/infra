# See https://www.keycloak.org/server/configuration
# See https://www.keycloak.org/server/all-config


# Despite its name, `keycloak.theme.login` is the switch for the custom image
# (ghcr.io/celine-eu/keycloak, which carries the `rec` themes) as a whole: unset, the
# stock image runs and `keycloak.image_tag` is ignored.
{{- if .Environment.Values | dig "keycloak" "theme" "login" "" }}
image:
  repository: ghcr.io/celine-eu/keycloak
  tag: {{ .Environment.Values | dig "keycloak" "image_tag" "latest" | quote }}

theme:
  login: {{ .Environment.Values | dig "keycloak" "theme" "login" "" }}
  account: ""
  email: ""

{{- end }}



command:
  - "/opt/keycloak/bin/kc.sh"
  - "--verbose"
  - "start"
  - "--spi-events-listener-jboss-logging-success-level=info"
  - "--spi-events-listener-jboss-logging-error-level=warn"
  - "--import-realm"

dbchecker:
  enabled: true

database:
  existingSecret: keycloak-db-secret
  existingSecretKey: password
  vendor: postgres
  hostname: postgis1-rw
  port: 5432
  dbname: keycloak
  username: keycloak

secrets:
  keycloak-admin-secret:
    stringData:
      username: {{ .Environment.Values.keycloak.username }}
      password: {{ .Environment.Values.keycloak.password }}

{{- /*
  The public host serves the platform realm and nothing else (requester, 2026-10-04). The
  Ingress lists the paths that are allowed, so everything else - `/admin` (the admin console
  and the admin REST API), `/realms/master`, any other realm, `/` - matches no rule and gets
  the ingress controller's 404. Path rules need no snippet annotation, which ingress-nginx
  refuses by default.

  The master realm and the admin console are reached only through `kubectl port-forward` to
  the Keycloak Service (`task keycloak:forward`), on http://localhost:<keycloak.admin_forward_port>.
  Everything inside the cluster that administers Keycloak (the policies-shell bootstrap and
  sync, provisioning) uses the Service, never this host.
*/}}
{{- $realm := .Environment.Values | dig "keycloak" "realm" "celine" }}
{{- $publicRealms := .Environment.Values | dig "keycloak" "public_realms" (list $realm) }}
{{- if has "master" $publicRealms }}
{{- fail "keycloak.public_realms must not name master: the master realm is reached only through a port-forward" }}
{{- end }}
{{- $adminPort := .Environment.Values | dig "keycloak" "admin_forward_port" 18080 | int }}
ingress:
  # If `true`, an Ingress is created
  enabled: true
  # The name of the Ingress Class associated with this ingress
  ingressClassName: "nginx"
  # The Service port targeted by the Ingress
  servicePort: http
  # Ingress annotations
  annotations:
    ## Resolve HTTP 502 error using ingress-nginx:
    ## See https://www.ibm.com/support/pages/502-error-ingress-keycloak-response
    nginx.ingress.kubernetes.io/proxy-buffer-size: 128k
    cert-manager.io/issuer: {{ .Environment.Values.tls_setup.issuer | default "celine-tls" }}

  # Additional Ingress labels
  labels: {}
    # List of rules for the Ingress
  rules:
    - host: "keycloak.{{ .Environment.Values.domain }}"
      # Only these paths reach Keycloak from outside: each public realm (sign-in, tokens,
      # discovery, JWKS, the account console, logout) and the static resources its pages
      # load. A Prefix path matches whole segments: /realms/celine does not match
      # /realms/celine2. The console ingress of the chart (ingress.console) stays off.
      paths:
        {{- range $publicRealms }}
        - path: /realms/{{ . }}
          pathType: Prefix
        {{- end }}
        - path: /resources
          pathType: Prefix
  # TLS configuration
  tls:
    - hosts:
        - "keycloak.{{ .Environment.Values.domain }}"
      secretName: keycloak-tls

proxy:
  enabled: true
  mode: xforwarded   # sets KC_PROXY_HEADERS=xforwarded
  http:
    enabled: true   # TLS always on — nginx terminates SSL, Keycloak sees plain HTTP internally

http:
  relativePath: "/"   # Keycloak 17+ serves at /realms/… by default; override chart default of /auth

extraEnv: |
  - name: KEYCLOAK_ADMIN
    valueFrom:
      secretKeyRef:
        name: keycloak-keycloakx-keycloak-admin-secret
        key: username
  - name: KEYCLOAK_ADMIN_PASSWORD
    valueFrom:
      secretKeyRef:
        name: keycloak-keycloakx-keycloak-admin-secret
        key: password
  - name: KC_HOSTNAME
    value: "https://keycloak.{{ .Environment.Values.domain }}"
  - name: KC_HOSTNAME_STRICT
    value: "false"
  # The admin console's own links and redirects, for the port-forward (`task keycloak:forward`
  # forwards to this port). localhost is a secure context, so plain http needs no
  # certificate. KC_HOSTNAME above stays the URL of every realm, issuers included. The
  # console also needs the master realm's Frontend URL set to the same value (see the
  # README, "Keycloak admin access").
  - name: KC_HOSTNAME_ADMIN
    value: "http://localhost:{{ $adminPort }}"
  - name: KEYCLOAK_IMPORT
    value: /opt/keycloak/data/import/celine-realm.json
  - name: KEYCLOAK_IMPORT_STRATEGY
    value: IGNORE_EXISTING  # prevents overwriting existing realm if already imported
{{- /* Footer links of the login and email theme (celine-policies `themes/rec`), when the
       environment has a legal host (`legal.base_url`): pages listing each community's
       terms and privacy notice, since a login page does not know its reader's community.
       Unset, the theme hides both links. */}}
{{- $legal := index .Environment.Values "legal" | default dict }}
{{- with index $legal "base_url" }}
  - name: TERMS_URL
    value: "{{ trimSuffix "/" . }}/terms/"
  - name: PRIVACY_URL
    value: "{{ trimSuffix "/" . }}/privacy/"
{{- end }}

extraVolumeMounts: |
  - name: realm-import
    mountPath: /opt/keycloak/data/import

extraVolumes: |
  - name: realm-import
    configMap:
      name: keycloak-realm-celine

# JVM app using 722Mi actual — needs a ceiling to prevent unbounded growth
resources:
  requests:
    cpu: 200m
    memory: 768Mi
  limits:
    cpu: 500m
    memory: 1Gi
