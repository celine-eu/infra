# See https://www.keycloak.org/server/configuration
# See https://www.keycloak.org/server/all-config


{{- /* A Keycloak run as its own environment (an instance shared by several realms, e.g. in
       a tenant namespace with Pod Security `restricted` and Traefik). Every option is
       opt-in; unset, the render is today's.
       - `keycloak.public_url`: the host's URL (default https://keycloak.<domain>), for the
         Ingress host and KC_HOSTNAME.
       - `keycloak.realm_import: false`: no realm import (a clean instance; celine-policies'
         `keycloak bootstrap` creates each realm), so no auth-setup ConfigMap is mounted.
       - `keycloak.database`: `host`, `dbname`, `username`, `existing_secret`,
         `existing_secret_key` (e.g. a CNPG `<cluster>-app` Secret), `url_properties`
         (KC_DB_URL_PROPERTIES, appended to the JDBC URL with its leading `?`, e.g. a
         session setting the database server would otherwise impose).
       - `keycloak.pod_security_context`: the pod's securityContext (e.g. seccompProfile
         RuntimeDefault, on a cluster that does not set it at admission).
       - `keycloak.backchannel_dynamic: true`: requests on the Service (back channel) get
         back-channel URLs on the Service, while issuers stay on the public URL.
       - `ingress_controller.annotations: traefik` and `tls_setup.ingress_cluster_issuer`:
         as for the other Ingresses. */}}
{{- $kcPublic := .Environment.Values | dig "keycloak" "public_url" (printf "https://keycloak.%s" .Environment.Values.domain) | toString | trimSuffix "/" }}
{{- $kcHost := $kcPublic | trimPrefix "https://" | trimPrefix "http://" }}
{{- $realmImport := ne (.Environment.Values | dig "keycloak" "realm_import" true | toString) "false" }}
{{- $ic := .Environment.Values | dig "ingress_controller" (dict) | default (dict) }}
{{- $traefik := eq ($ic | dig "annotations" "nginx" | toString) "traefik" }}
{{- $ns := .Environment.Values | dig "namespace" (printf "celine-%s" .Environment.Name) | toString }}
{{- $clusterIssuer := .Environment.Values | dig "tls_setup" "ingress_cluster_issuer" "" | toString }}
{{- $db := .Environment.Values | dig "keycloak" "database" (dict) | default (dict) }}

# Despite its name, `keycloak.theme.login` is the switch for the custom image
# (ghcr.io/celine-eu/keycloak, which carries the `rec` themes) as a whole: unset, the
# stock image runs and `keycloak.image_tag` is ignored.
{{- /* Digests from `image_digests` ({repository: {tag: sha256:…}}), as for the CELINE
       services. keycloakx renders `repository@digest` (the tag stays in the version label). */}}
{{- $digests := .Environment.Values | dig "image_digests" (dict) }}
{{- $kcTag := .Environment.Values | dig "keycloak" "image_tag" "latest" | toString }}
{{- $kcDigest := $digests | dig "ghcr.io/celine-eu/keycloak" $kcTag "" }}
{{- $bbDigest := $digests | dig "docker.io/busybox" "1.32" "" }}
{{- range (list $kcDigest $bbDigest) }}
{{- if and . (not (regexMatch "^sha256:[a-f0-9]{64}$" .)) }}
{{- fail (printf "image_digests: %q is not a sha256 digest (sha256:<64 hex>)" .) }}
{{- end }}
{{- end }}
{{- if .Environment.Values | dig "keycloak" "theme" "login" "" }}
image:
  repository: ghcr.io/celine-eu/keycloak
  tag: {{ $kcTag | quote }}
  digest: {{ $kcDigest | quote }}

theme:
  login: {{ .Environment.Values | dig "keycloak" "theme" "login" "" }}
  account: ""
  email: ""

{{- end }}



command:
  - "/opt/keycloak/bin/kc.sh"
  - "--verbose"
  - "start"
  - "--spi-events-listener-jboss-logging-success-level=info"
  - "--spi-events-listener-jboss-logging-error-level=warn"
  {{- if $realmImport }}
  - "--import-realm"
  {{- end }}

{{- with .Environment.Values | dig "keycloak" "pod_security_context" nil }}
podSecurityContext:
  {{- toYaml . | nindent 2 }}
{{- end }}

# Pod Security `restricted`: the chart's contexts (uid 1000, non-root) plus no privilege
# escalation and no capabilities, for Keycloak and its database check.
securityContext:
  runAsUser: 1000
  runAsNonRoot: true
  allowPrivilegeEscalation: false
  capabilities:
    drop: [ALL]

dbchecker:
  enabled: true
  # The chart's image, named here so its digest can be looked up.
  image:
    repository: docker.io/busybox
    tag: "1.32"
    digest: {{ $bbDigest | quote }}
  securityContext:
    allowPrivilegeEscalation: false
    runAsUser: 1000
    runAsGroup: 1000
    runAsNonRoot: true
    capabilities:
      drop: [ALL]

database:
  existingSecret: {{ $db | dig "existing_secret" "keycloak-db-secret" }}
  existingSecretKey: {{ $db | dig "existing_secret_key" "password" }}
  vendor: postgres
  hostname: {{ $db | dig "host" "postgis1-rw" }}
  port: 5432
  # Not a key of the chart (it reads `database`): Keycloak's default database, keycloak.
  dbname: keycloak
  {{- with $db | dig "dbname" "" }}
  database: {{ . }}
  {{- end }}
  username: {{ $db | dig "username" "keycloak" }}

secrets:
  keycloak-admin-secret:
    stringData:
      username: {{ .Environment.Values.keycloak.username }}
      password: {{ .Environment.Values.keycloak.password }}

{{- /*
  The public host serves the platform realm and nothing else (requester, 2026-10-04). The
  Ingress lists the paths that are allowed, so everything else - `/admin` (the admin console
  and the admin REST API), `/realms/master`, any other realm, `/` - matches no rule and gets
  the ingress controller's 404. Path rules need no snippet annotation, which ingress-nginx
  refuses by default.

  The master realm and the admin console are reached only through `kubectl port-forward` to
  the Keycloak Service (`task keycloak:forward`), on http://localhost:<keycloak.admin_forward_port>.
  Everything inside the cluster that administers Keycloak (the policies-shell bootstrap and
  sync, provisioning) uses the Service, never this host.

  Outside prod, `keycloak.admin_public` (`enabled`, `allow_source_ranges`) serves the admin
  console and master on this host too, from the allowlist only: a browser impersonation must
  start on the host whose cookies the platform sees. The admin hostname, and master's
  Frontend URL with it (policies-shell), then move to this host and the port-forward no
  longer serves the console. Prod never renders it, and the allowlist is an ingress-nginx
  annotation, so another controller stops the render.
*/}}
{{- $realm := .Environment.Values | dig "keycloak" "realm" "celine" }}
{{- $publicRealms := .Environment.Values | dig "keycloak" "public_realms" (list $realm) }}
{{- if has "master" $publicRealms }}
{{- fail "keycloak.public_realms must not name master: the master realm is reached only through a port-forward" }}
{{- end }}
{{- $adminPort := .Environment.Values | dig "keycloak" "admin_forward_port" 18080 | int }}
{{- $adminPublic := .Environment.Values | dig "keycloak" "admin_public" (dict) | default (dict) }}
{{- $adminPublicOn := eq ($adminPublic | dig "enabled" false | toString) "true" }}
{{- $adminRanges := list }}
{{- if $adminPublicOn }}
{{- $celineEnv := .Environment.Values | dig "celine_env" .Environment.Name | toString | trim | lower }}
{{- if or (eq .Environment.Name "prod") (eq $celineEnv "prod") }}
{{- fail (printf "keycloak.admin_public is never enabled in prod (environment %s, celine_env %s): prod's admin console stays on the port-forward" .Environment.Name $celineEnv) }}
{{- end }}
{{- $ranges := $adminPublic | dig "allow_source_ranges" nil }}
{{- if not (and (kindIs "slice" $ranges) $ranges) }}
{{- fail "keycloak.admin_public.allow_source_ranges is required when keycloak.admin_public.enabled: a non-empty list of CIDRs, e.g. [192.168.1.47/32]" }}
{{- end }}
{{- range $ranges }}
{{- $range := toString . | trim }}
{{- if not (regexMatch "^(([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}|[0-9a-fA-F:]+/[0-9]{1,3})$" $range) }}
{{- fail (printf "keycloak.admin_public.allow_source_ranges: %q is not a CIDR (address/prefix)" $range) }}
{{- end }}
{{- if hasSuffix "/0" $range }}
{{- fail (printf "keycloak.admin_public.allow_source_ranges: %q admits every address" $range) }}
{{- end }}
{{- $adminRanges = append $adminRanges $range }}
{{- end }}
{{- if ne (.Values | dig "ingress_controller" "class" "nginx" | toString) "nginx" }}
{{- fail "keycloak.admin_public needs ingress-nginx: the allowlist is its whitelist-source-range annotation, which another controller ignores" }}
{{- end }}
{{- end }}
{{- $adminUrl := ternary $kcPublic (printf "http://localhost:%d" $adminPort) $adminPublicOn }}
ingress:
  # If `true`, an Ingress is created
  enabled: true
  # The name of the Ingress Class associated with this ingress
  ingressClassName: {{ .Values | dig "ingress_controller" "class" "nginx" | quote }}
  # The Service port targeted by the Ingress
  servicePort: http
  # Ingress annotations
  annotations:
    {{- if $clusterIssuer }}
    cert-manager.io/cluster-issuer: {{ $clusterIssuer }}
    {{- else }}
    cert-manager.io/issuer: {{ .Environment.Values.tls_setup.issuer | default "celine-tls" }}
    {{- end }}
    {{- if $traefik }}
    traefik.ingress.kubernetes.io/router.entrypoints: {{ $ic | dig "entrypoint" "websecure" }}
    {{- with $ic | dig "tls_options" "" }}
    traefik.ingress.kubernetes.io/router.tls.options: {{ printf "%s-%s@kubernetescrd" $ns . }}
    {{- end }}
    {{- else }}
    ## Resolve HTTP 502 error using ingress-nginx:
    ## See https://www.ibm.com/support/pages/502-error-ingress-keycloak-response
    nginx.ingress.kubernetes.io/proxy-buffer-size: 128k
    {{- end }}
    {{- if and (not $traefik) (.Environment.Values | dig "security_headers" "enabled" true) }}
    # nosniff on this host, the controller's own answers included (the 404 on `/`): the
    # ConfigMap is auth-setup's (templates/keycloak-security-headers.yaml), which this
    # release `needs`. Off in dev, like every public host's headers.
    nginx.ingress.kubernetes.io/custom-headers: "{{ .Release.Namespace }}/keycloak-security-headers"
    {{- end }}

  # Additional Ingress labels
  labels: {}
    # List of rules for the Ingress
  rules:
    - host: "{{ $kcHost }}"
      # Only these paths reach Keycloak from outside: each public realm (sign-in, tokens,
      # discovery, JWKS, the account console, logout) and the static resources its pages
      # load. A Prefix path matches whole segments: /realms/celine does not match
      # /realms/celine2. The console ingress of the chart (ingress.console) stays off.
      paths:
        {{- range $publicRealms }}
        - path: /realms/{{ . }}
          pathType: Prefix
        {{- end }}
        - path: /resources
          pathType: Prefix
  # The admin console and master on the same host, from the allowlist only
  # (keycloak.admin_public, never in prod). The chart's console Ingress, with the public
  # Ingress's TLS. Off: no such Ingress, `/admin` and `/realms/master` answer 404.
  console:
    enabled: {{ $adminPublicOn }}
    {{- if $adminPublicOn }}
    ingressClassName: {{ .Values | dig "ingress_controller" "class" "nginx" | quote }}
    annotations:
      nginx.ingress.kubernetes.io/whitelist-source-range: {{ join "," $adminRanges | quote }}
      nginx.ingress.kubernetes.io/proxy-buffer-size: 128k
      {{- if .Environment.Values | dig "security_headers" "enabled" true }}
      nginx.ingress.kubernetes.io/custom-headers: "{{ .Release.Namespace }}/keycloak-security-headers"
      {{- end }}
    rules:
      - host: "{{ $kcHost }}"
        paths:
          - path: /admin
            pathType: Prefix
          - path: /realms/master
            pathType: Prefix
    {{- end }}
  # TLS configuration
  tls:
    - hosts:
        - "{{ $kcHost }}"
      secretName: keycloak-tls

proxy:
  enabled: true
  mode: xforwarded   # sets KC_PROXY_HEADERS=xforwarded
  http:
    enabled: true   # TLS always on — nginx terminates SSL, Keycloak sees plain HTTP internally

http:
  relativePath: "/"   # Keycloak 17+ serves at /realms/… by default; override chart default of /auth

extraEnv: |
  - name: KEYCLOAK_ADMIN
    valueFrom:
      secretKeyRef:
        name: keycloak-keycloakx-keycloak-admin-secret
        key: username
  - name: KEYCLOAK_ADMIN_PASSWORD
    valueFrom:
      secretKeyRef:
        name: keycloak-keycloakx-keycloak-admin-secret
        key: password
  - name: KC_HOSTNAME
    value: "{{ $kcPublic }}"
  - name: KC_HOSTNAME_STRICT
    value: "false"
  {{- with $db | dig "url_properties" "" }}
  - name: KC_DB_URL_PROPERTIES
    value: {{ . | quote }}
  {{- end }}
  {{- if eq (.Environment.Values | dig "keycloak" "backchannel_dynamic" false | toString) "true" }}
  - name: KC_HOSTNAME_BACKCHANNEL_DYNAMIC
    value: "true"
  {{- end }}
  # The admin console's own links and redirects, for the port-forward (`task keycloak:forward`
  # forwards to this port), or the public host when keycloak.admin_public is on. localhost is
  # a secure context, so plain http needs no certificate. KC_HOSTNAME above stays the URL of every realm, issuers included. The
  # console also needs the master realm's Frontend URL set to the same value: the
  # policies-shell bootstrap sets it on every start, from the same admin_forward_port
  # (README, "Keycloak admin access").
  - name: KC_HOSTNAME_ADMIN
    value: "{{ $adminUrl }}"
  {{- if $realmImport }}
  - name: KEYCLOAK_IMPORT
    value: /opt/keycloak/data/import/celine-realm.json
  - name: KEYCLOAK_IMPORT_STRATEGY
    value: IGNORE_EXISTING  # prevents overwriting existing realm if already imported
  {{- end }}
{{- /* Footer links of the login and email theme (celine-policies `themes/rec`), when the
       environment has a legal host (`legal.base_url`, or the `legal` release installed):
       pages listing each community's terms and privacy notice, since a login page does
       not know its reader's community. Without one, the theme hides both links. */}}
{{- $legal := .Environment.Values | dig "legal" (dict) | default (dict) }}
{{- $legalHost := $legal | dig "host" (printf "legal.%s" .Environment.Values.domain) }}
{{- $legalBase := $legal | dig "base_url" (ternary (printf "https://%s" $legalHost) "" ($legal | dig "enabled" false)) | trimSuffix "/" }}
{{- /* `legal.applications_read_draft`: the draft at `legal.draft_revision` instead, for an
       environment whose applications review the texts before any release. */}}
{{- if eq (toString ($legal | dig "applications_read_draft" false)) "true" }}
{{- $draftRevision := $legal | dig "draft_revision" "" | toString }}
{{- if not (and (eq (toString ($legal | dig "enabled" false)) "true") (eq (toString ($legal | dig "draft" false)) "true") (regexMatch "^[0-9a-f]{40}$" $draftRevision)) }}
{{- fail "legal.applications_read_draft needs legal.enabled, legal.draft and legal.draft_revision (the draft's 40-hex commit)" }}
{{- end }}
{{- $legalBase = printf "https://%s/draft/%s" $legalHost $draftRevision }}
{{- end }}
{{- with $legalBase }}
  - name: TERMS_URL
    value: "{{ . }}/terms/"
  - name: PRIVACY_URL
    value: "{{ . }}/privacy/"
{{- end }}

{{- if $realmImport }}
extraVolumeMounts: |
  - name: realm-import
    mountPath: /opt/keycloak/data/import

extraVolumes: |
  - name: realm-import
    configMap:
      name: keycloak-realm-celine
{{- end }}

# The chart's pod anti-affinity (required per node, preferred per zone) stays unless the
# environment sets `keycloak.pod_anti_affinity: false`: GKE Autopilot rejects anti-affinity
# below 500m CPU requested, and with one replica it spreads nothing.
{{- if not (.Environment.Values | dig "keycloak" "pod_anti_affinity" true) }}
affinity: ""
{{- end }}

# Where the pod runs (`keycloak.node_selector`), e.g. cloud.google.com/private-node: "true":
# a node without an external address, so the realm's mail leaves through Cloud NAT, whose
# address Brevo's allowlist holds. Unset: the chart's default, no selector.
{{- with .Environment.Values | dig "keycloak" "node_selector" nil }}
nodeSelector:
  {{- toYaml . | nindent 2 }}
{{- end }}

# `pod_disruption.keycloak` (defaults/0050-celine-services/pod-disruption.yaml.gotmpl): pod
# annotations and the chart's PodDisruptionBudget, so a node scale-down does not stop every
# sign-in. Absent, nothing changes (the chart renders no budget).
{{- $pd := .Environment.Values | dig "pod_disruption" .Release.Name (dict) | default (dict) }}
{{- with $pd | dig "pod_annotations" (dict) }}
podAnnotations:
  {{- toYaml . | nindent 2 }}
{{- end }}
{{- if eq (toString ($pd | dig "pdb" false)) "true" }}
podDisruptionBudget:
  maxUnavailable: {{ $pd | dig "max_unavailable" 0 | int }}
{{- end }}

# JVM app using 722Mi actual — needs a ceiling to prevent unbounded growth
resources:
  requests:
    cpu: 200m
    memory: 768Mi
  limits:
    cpu: 500m
    memory: 1Gi
