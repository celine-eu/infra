# Baseline values for mosquitto-go-auth across all environments.
# Override only what differs in envs/<env>/0030-apps/mosquitto-go-auth/values.yaml.gotmpl

# Keep the Service name stable so mqtt-setup and mqtt-ingestor don't need changes.
# mqtt-setup uses host: mqtt-mosquitto, mqtt-ingestor uses mqtt-account-readonly Secret.
fullnameOverride: mqtt-mosquitto

mosquitto:
  allowAnonymous: false
  logDest: stdout
  logType: warning
  maxInflightMessages: 20
  maxQueuedMessages: 1000
  persistence: true
  persistenceLocation: /data/

listeners:
  mqtt:
    port: 1883
  mqtts:
    enabled: {{ .Environment.Values.tls_setup.self_signed | default false }}
    port: 8883
    caSecret: {{ .Environment.Values.tls_setup.ca_secret | default "" | quote }}
    certSecret: "celine-wildcard-tls"
  websocket:
    port: 1884

{{- /* go-auth at debug writes whole bearer tokens to the broker log: dev only. */}}
{{- $goAuthLog := .Environment.Values | dig "mosquitto" "go_auth_log_level" "info" | toString | lower }}
{{- if and (ne .Environment.Name "dev") (eq $goAuthLog "debug") }}
{{- fail (printf "mosquitto.go_auth_log_level is debug in environment %s: go-auth then logs whole JWTs; only the dev environment may" .Environment.Name) }}
{{- end }}
goAuth:
  logLevel: {{ $goAuthLog }}
  logDest: stdout
  # There is no MQTT superuser (celine-policies REQ-0014): mqtt-auth's /superuser never grants
  # one, so every client gets only its ACL. The plugin (3.3.0) ignores
  # auth_opt_disable_superuser for the JWT backend, so no such switch is set.

  jwt:
    host: "mqtt-auth"
    port: 8009
    httpTimeout: 5
    getUserUri: "/user"
    aclUri: "/acl"
    superuserUri: "/superuser"

  files:
    enabled: true

  cache:
    enabled: false
    reset: true
    refresh: true
    type: redis
    host: "redis-master"
    port: 6379
    db: 3
    password: ""
    authCacheSeconds: 30
    aclCacheSeconds: 30
    authJitterSeconds: 3
    aclJitterSeconds: 3

persistence:
  data:
    enabled: true
    size: 1Gi
    storageClass: ""

service:
  type: ClusterIP

podSecurityContext:
  fsGroup: 1883

securityContext:
  runAsNonRoot: true
  runAsUser: 1883
  readOnlyRootFilesystem: true
  allowPrivilegeEscalation: false
  capabilities:
    drop: [ALL]

resources:
  requests:
    cpu: 10m
    memory: 8Mi
  limits:
    cpu: 100m
    memory: 32Mi

# Images pinned by digest where the environment lists them (`image_digests`,
# {repository: {tag: sha256:…}}; celine-services.imageRef). Empty: images by tag.
imageDigests: {{ .Values | dig "image_digests" (dict) | toJson }}
