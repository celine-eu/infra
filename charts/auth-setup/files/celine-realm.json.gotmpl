{
  "id": "0c1045cc-7e38-4235-8a5b-502a2c4ae1ac",
  "realm": "{{ .Values.realm }}",
  
  "accessTokenLifespan": 3600,
  "accessTokenLifespanForImplicitFlow": 3600,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 86400,

  "enabled": true,
  "displayName": "{{ upper .Values.realm }}",
  "editUsernameAllowed": false,

  {{- if .Values.theme.login }}
  "loginTheme": {{ .Values.theme.login | quote }},
  {{- end }}
  {{- if .Values.theme.account }}
  "accountTheme": {{ .Values.theme.account | quote }},
  {{- end }}
  {{- if .Values.theme.email }}
  "emailTheme": {{ .Values.theme.email | quote }},
  {{- end }}

  {{- if .Values.smtp.enabled }}
  {{- with .Values.smtp }}
  "smtpServer": {
    "host": {{ .host | quote }},
    "port": {{ .port | toString | quote }},
    "from": {{ .from | quote }},
    "fromDisplayName": {{ .fromDisplayName | quote }},
    "replyTo": {{ .replyTo | default "" | quote }},
    "ssl": {{ .ssl | toString | quote }},
    "starttls": {{ .starttls | toString | quote }},
    "auth": {{ .auth | toString | quote }}
    {{- if .auth }},
    "user": {{ .user | quote }},
    "password": {{ .password | quote }}
    {{- end }}
  },
  {{- end }}
  {{- end }}

  {{- with .Values.bruteForce }}
  "bruteForceProtected": {{ .enabled }},
  {{- if .enabled }}
  "permanentLockout": {{ .permanentLockout }},
  "waitIncrementSeconds": {{ .waitIncrementSeconds }},
  "quickLoginCheckMilliSeconds": {{ .quickLoginCheckMilliSeconds }},
  "minimumQuickLoginWaitSeconds": {{ .minimumQuickLoginWaitSeconds }},
  "maxFailureWaitSeconds": {{ .maxFailureWaitSeconds }},
  "failureFactor": {{ .failureFactor }},
  {{- end }}
  {{- end }}

  {{- /*
    The admin second factor (keycloak.admin_mfa). Provider ids are Keycloak 26.7.3's
    `conditional-*`: an unknown id is accepted by the import and then fails every browser
    sign-in, for every user. The shape was verified on a throwaway 26.7.3 realm
    (celine-policies' passkey plan, Phase 1): a non-admin is never asked; an admin who used
    a passkey is not asked; an admin with TOTP or recovery codes is asked for one; an admin
    with neither enrols both.
  */}}
  "browserFlow": {{ if .Values.adminMfa.enabled }}"browser-admin-second-factor"{{ else }}"browser"{{ end }},

  {{- if .Values.adminMfa.enabled }}
  "authenticationFlows": [
    {
      "alias": "browser-admin-second-factor",
      "description": "Password or passkey for everyone; platform admins who did not use a passkey also need TOTP or a recovery code",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-spnego",
          "requirement": "DISABLED",
          "priority": 20,
          "authenticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "browser-admin-second-factor organization",
          "requirement": "ALTERNATIVE",
          "priority": 26,
          "authenticatorFlow": true
        },
        {
          "flowAlias": "browser-admin-second-factor forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-admin-second-factor organization",
      "description": "As in Keycloak's own browser flow",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "browser-admin-second-factor conditional organization",
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-admin-second-factor conditional organization",
      "description": "Organization identity-first login, for users who belong to one",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "organization",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "browser-admin-second-factor forms",
      "description": "Username and password, or a passkey from the same page",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "browser-admin-second-factor admin",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-admin-second-factor admin",
      "description": "Platform admins who did not sign in with a passkey",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "browser-admin-second-factor-admin-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "conditional-credential",
          "authenticatorConfig": "browser-admin-second-factor-no-passkey",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "browser-admin-second-factor configured",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "authenticatorFlow": true
        },
        {
          "flowAlias": "browser-admin-second-factor enrol",
          "requirement": "CONDITIONAL",
          "priority": 40,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-admin-second-factor configured",
      "description": "An admin who has a second factor uses it",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-recovery-authn-code-form",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "browser-admin-second-factor enrol",
      "description": "An admin who has none enrols TOTP and recovery codes. Without this branch Keycloak refuses them as 'invalid username or password'",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-sub-flow-executed",
          "authenticatorConfig": "browser-admin-second-factor-not-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-recovery-authn-code-form",
          "requirement": "REQUIRED",
          "priority": 30,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "browser-admin-second-factor-admin-role",
      "config": {
        "condUserRole": {{ required "adminMfa.role is required when admin MFA is enabled" .Values.adminMfa.role | quote }},
        "negate": "false"
      }
    },
    {
      "alias": "browser-admin-second-factor-no-passkey",
      "config": {
        "credentials": "webauthn-passwordless",
        "included": "false"
      }
    },
    {
      "alias": "browser-admin-second-factor-not-configured",
      "config": {
        "flow_to_check": "browser-admin-second-factor configured",
        "check_result": "not-executed"
      }
    }
  ],
  {{- else }}
  "authenticationFlows": [],
  "authenticatorConfig": [],
  {{- end }}


  "roles": {
    "realm": [
      {
        "name": "admin",
        "containerId": "0c1045cc-7e38-4235-8a5b-502a2c4ae1ac"
      },
      {
        "name": "manager",
        "containerId": "0c1045cc-7e38-4235-8a5b-502a2c4ae1ac"
      },
      {
        "name": "editor",
        "containerId": "0c1045cc-7e38-4235-8a5b-502a2c4ae1ac"
      },
      {
        "name": "viewer",
        "containerId": "0c1045cc-7e38-4235-8a5b-502a2c4ae1ac"
      }
    ]
  },

  "users": [
    {
      "username": "{{ .Values.realmAdmin.username | default "celine-admin" }}",
      "email": "{{ .Values.realmAdmin.email | default "admin@celine.test" }}",
      "firstName": "Celine",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "{{ .Values.realmAdmin.password | default "admin" }}",
          "temporary": false
        }
      ],
      "groups": [
        "admins"
      ]
    }
  ],
  "groups": [
    {
      "name": "admins",
      "path": "/admins",
      "realmRoles": [
        "admin"
      ]
    },
    {
      "name": "managers",
      "path": "/managers",
      "realmRoles": [
        "manager"
      ]
    },
    {
      "name": "editors",
      "path": "/editors",
      "realmRoles": [
        "editor"
      ]
    },
    {
      "name": "viewers",
      "path": "/viewers",
      "realmRoles": [
        "viewer"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "oauth2_proxy",
      "name": "oauth2_proxy",
      "description": "OIDC client for oauth2-proxy",
      "rootUrl": "",
      "adminUrl": "",
      "baseUrl": "",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",      
      "secret": "{{ .Values.oauth2Proxy.clientSecret }}",
      "redirectUris": [
        "https://sso.{{ .Values.domain }}/oauth2/callback",
        "https://superset.{{ .Values.domain }}/*/",
        "https://webapp.{{ .Values.domain }}/*",
        "https://assistant.{{ .Values.domain }}/*",
        "https://grid.{{ .Values.domain }}/*",
        "https://roi.{{ .Values.domain }}/*"
      ],
      "webOrigins": [
        "https://*.{{ .Values.domain }}"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "realm_client": "false",
        "oidc.ciba.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "standard.token.exchange.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "display.on.consent.screen": "false",
        "backchannel.logout.revoke.offline.tokens": "false",
        "access.token.lifespan": "1800",
        "client.session.idle.timeout": "1800",
        "client.session.max.lifespan": "1800",
        "refresh.token.max.reuse": "0",
        "use.refresh.tokens": "true"
      },
      "authenticationFlowBindingOverrides": {},
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "protocolMappers": [
        {
          "name": "aud-mapper-oauth2_proxy",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "oauth2_proxy",
            "id.token.claim": "true",
            "lightweight.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
            "name": "aud-mapper-dataset-api",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
                "included.client.audience": "svc-dataset-api",
                "access.token.claim": "true",
                "id.token.claim": "false",
                "introspection.token.claim": "true",
                "lightweight.claim": "false"
            }
        },
        {
            "name": "aud-mapper-nudging",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
                "included.client.audience": "svc-nudging",
                "access.token.claim": "true",
                "id.token.claim": "false",
                "introspection.token.claim": "true",
                "lightweight.claim": "false"
            }
        },
        {
            "name": "aud-mapper-rec-registry",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
                "included.client.audience": "svc-rec-registry",
                "access.token.claim": "true",
                "id.token.claim": "false",
                "introspection.token.claim": "true",
                "lightweight.claim": "false"
            }
        },
        {
            "name": "aud-mapper-digital-twin",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
                "included.client.audience": "svc-digital-twin",
                "access.token.claim": "true",
                "id.token.claim": "false",
                "introspection.token.claim": "true",
                "lightweight.claim": "false"
            }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups",
            "jsonType.label": "String"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "organization",
        "microprofile-jwt"
      ],
      "access": {
        "view": true,
        "configure": true,
        "manage": true
      }
    }
  ]
}