{
  "id": "0c1045cc-7e38-4235-8a5b-502a2c4ae1ac",
  "realm": "{{ .Values.realm }}",
  
  "accessTokenLifespan": 3600,
  "accessTokenLifespanForImplicitFlow": 3600,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 86400,

  "enabled": true,
  "displayName": "{{ upper .Values.realm }}",
  "editUsernameAllowed": false,

  {{- if .Values.theme.login }}
  "loginTheme": {{ .Values.theme.login | quote }},
  {{- end }}
  {{- if .Values.theme.account }}
  "accountTheme": {{ .Values.theme.account | quote }},
  {{- end }}
  {{- if .Values.theme.email }}
  "emailTheme": {{ .Values.theme.email | quote }},
  {{- end }}

  {{- if .Values.smtp.enabled }}
  {{- with .Values.smtp }}
  "smtpServer": {
    "host": {{ .host | quote }},
    "port": {{ .port | toString | quote }},
    "from": {{ .from | quote }},
    "fromDisplayName": {{ .fromDisplayName | quote }},
    "replyTo": {{ .replyTo | default "" | quote }},
    "ssl": {{ .ssl | toString | quote }},
    "starttls": {{ .starttls | toString | quote }},
    "auth": {{ .auth | toString | quote }}
    {{- if .auth }},
    "user": {{ .user | quote }},
    "password": {{ .password | quote }}
    {{- end }}
  },
  {{- end }}
  {{- end }}

  {{- with .Values.bruteForce }}
  "bruteForceProtected": {{ .enabled }},
  {{- if .enabled }}
  "permanentLockout": {{ .permanentLockout }},
  "waitIncrementSeconds": {{ .waitIncrementSeconds }},
  "quickLoginCheckMilliSeconds": {{ .quickLoginCheckMilliSeconds }},
  "minimumQuickLoginWaitSeconds": {{ .minimumQuickLoginWaitSeconds }},
  "maxFailureWaitSeconds": {{ .maxFailureWaitSeconds }},
  "failureFactor": {{ .failureFactor }},
  {{- end }}
  {{- end }}

  {{- /*
    No admin second factor here. celine-policies `keycloak bootstrap` owns it (REQ-0015,
    ADR-0013): it builds and binds the flow `browser-admin-second-factor` on the realm role
    `platform-admin` outside dev, on every policies-shell start, and corrects an older
    import's flow in place. An import reaches new realms only, so it could never be the
    owner. `keycloak.admin_mfa` is now read by the policies-shell release.
  */}}
  "browserFlow": "browser",
  "authenticationFlows": [],
  "authenticatorConfig": [],


  {{- /*
    Two levels, nothing in between (celine-policies ADR-0012). The realm role `platform-admin`
    is the only platform-wide grant: services read it from `realm_access.roles` (the `roles`
    scope, access token only). An organisation's own groups (admins > managers > editors >
    viewers) reach a token only inside `organization.<alias>.groups` and are valid only in
    that organisation. There are no realm groups and no realm roles admin/manager/editor/
    viewer: their names collide with the organisation groups. Holders are granted the role
    directly, never through a group or a composite role.
  */}}
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "The only platform-wide grant (celine-policies ADR-0012)",
        "containerId": "0c1045cc-7e38-4235-8a5b-502a2c4ae1ac"
      }
    ]
  },

  "users": [
    {
      "username": "{{ .Values.realmAdmin.username | default "celine-admin" }}",
      "email": "{{ .Values.realmAdmin.email | default "admin@celine.test" }}",
      "firstName": "Celine",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "{{ .Values.realmAdmin.password | default "admin" }}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "platform-admin"
      ]
    }
  ],
  "groups": [],
  "clients": [
    {
      "clientId": "oauth2_proxy",
      "name": "oauth2_proxy",
      "description": "OIDC client for oauth2-proxy",
      "rootUrl": "",
      "adminUrl": "",
      "baseUrl": "",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",      
      "secret": "{{ .Values.oauth2Proxy.clientSecret }}",
      "redirectUris": [
        "https://sso.{{ .Values.domain }}/oauth2/callback",
        "https://superset.{{ .Values.domain }}/*/",
        "https://webapp.{{ .Values.domain }}/*",
        "https://assistant.{{ .Values.domain }}/*",
        "https://grid.{{ .Values.domain }}/*",
        "https://roi.{{ .Values.domain }}/*"
      ],
      "webOrigins": [
        "https://*.{{ .Values.domain }}"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "realm_client": "false",
        "oidc.ciba.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "standard.token.exchange.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "display.on.consent.screen": "false",
        "backchannel.logout.revoke.offline.tokens": "false",
        "access.token.lifespan": "1800",
        "client.session.idle.timeout": "1800",
        "client.session.max.lifespan": "1800",
        "refresh.token.max.reuse": "0",
        "use.refresh.tokens": "true"
      },
      "authenticationFlowBindingOverrides": {},
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "protocolMappers": [
        {
          "name": "aud-mapper-oauth2_proxy",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "oauth2_proxy",
            "id.token.claim": "true",
            "lightweight.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
            "name": "aud-mapper-dataset-api",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
                "included.client.audience": "svc-dataset-api",
                "access.token.claim": "true",
                "id.token.claim": "false",
                "introspection.token.claim": "true",
                "lightweight.claim": "false"
            }
        },
        {
            "name": "aud-mapper-nudging",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
                "included.client.audience": "svc-nudging",
                "access.token.claim": "true",
                "id.token.claim": "false",
                "introspection.token.claim": "true",
                "lightweight.claim": "false"
            }
        },
        {
            "name": "aud-mapper-rec-registry",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
                "included.client.audience": "svc-rec-registry",
                "access.token.claim": "true",
                "id.token.claim": "false",
                "introspection.token.claim": "true",
                "lightweight.claim": "false"
            }
        },
        {
            "name": "aud-mapper-digital-twin",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-audience-mapper",
            "consentRequired": false,
            "config": {
                "included.client.audience": "svc-digital-twin",
                "access.token.claim": "true",
                "id.token.claim": "false",
                "introspection.token.claim": "true",
                "lightweight.claim": "false"
            }
        },
        {{- /*
          The only groups mapper: organisation groups, inside `organization.<alias>.groups`.
          Nothing writes a top-level `groups` claim (no realm group mapper, no `microprofile-jwt`,
          which copies realm roles into `groups`). celine-policies `sync` puts the same mapper on
          the `organization` scope; the two together still list each group once (measured on
          Keycloak 26.7.3).
        */}}
        {
          "name": "organization group membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ],
      {{- /* `roles` carries `platform-admin` in realm_access.roles: required on every client
             whose user tokens a service reads (celine-policies REQ-0013). */}}
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "organization"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ],
      "access": {
        "view": true,
        "configure": true,
        "manage": true
      }
    }
  ]
}