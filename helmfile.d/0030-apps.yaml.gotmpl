# Environments: `dev` is the one versioned here; every other one is discovered, any envs/<name>/
# holding a values.yaml (a directory or a link to one, never committed here). Each gets, in
# order: values.yaml, addons.yaml.gotmpl when present (README, "Add-on layer"), its
# secrets.sops.yaml when present. No other environment name is written here.
environments:
  dev:
    values:
      - ../envs/dev/values.yaml
      {{- if isFile "../envs/dev/addons.yaml.gotmpl" }}
      - ../envs/dev/addons.yaml.gotmpl
      {{- end }}
    secrets:
      - ../envs/dev/secrets.sops.yaml
  {{- range $e := readDirEntries "../envs" }}
  {{- $dir := printf "../envs/%s" $e.Name }}
  {{- if and (ne $e.Name "dev") (not (hasPrefix "." $e.Name)) (isFile (printf "%s/values.yaml" $dir)) }}
  {{ $e.Name }}:
    values:
      - {{ $dir }}/values.yaml
      {{- if isFile (printf "%s/addons.yaml.gotmpl" $dir) }}
      - {{ $dir }}/addons.yaml.gotmpl
      {{- end }}
    {{- if isFile (printf "%s/secrets.sops.yaml" $dir) }}
    secrets:
      - {{ $dir }}/secrets.sops.yaml
    {{- end }}
  {{- end }}
  {{- end }}
---
# The namespace: the environment value `namespace`, by default celine-<environment name>.
{{- $ns := .Environment.Values | dig "namespace" (printf "celine-%s" .Environment.Name) | toString }}
repositories:
  - name: superset
    url: https://apache.github.io/superset
  - name: qdrant
    url: https://qdrant.github.io/qdrant-helm

# hooks:
#   - events: ["prepare"]
#     command: "./scripts/generate-configs.sh"
#     args: ["apps", "{{ .Environment.Name }}"]

releases:
  - name: superset
    namespace: {{ $ns }}
    chart: superset/superset
    version: 0.15.0
    installed: {{ .Environment.Values | dig "superset" "enabled" true }}
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0030-apps/superset/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0030-apps/superset/values.yaml.gotmpl
    labels:
      group: apps

  - name: marquez
    namespace: {{ $ns }}
    chart: ../charts/marquez
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0030-apps/marquez/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0030-apps/marquez/values.yaml.gotmpl
    labels:
      group: apps

  - name: mosquitto-go-auth
    namespace: {{ $ns }}
    chart: ../charts/mosquitto-go-auth
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0030-apps/mosquitto-go-auth/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0030-apps/mosquitto-go-auth/values.yaml.gotmpl
    labels:
      group: apps

  - name: mqtt-setup
    namespace: {{ $ns }}
    chart: ../charts/mqtt-setup
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0030-apps/mqtt-setup/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0030-apps/mqtt-setup/values.yaml.gotmpl
    labels:
      group: apps

{{- if .Values.mqtt_ingestor.enabled }}
  - name: mqtt-ingestor
    namespace: {{ $ns }}
    chart: ../charts/mqtt-ingestor
    createNamespace: true
    missingFileHandler: Warn
    needs:
      - {{ $ns }}/mqtt-setup
    values:
      - ../defaults/0030-apps/mqtt-ingestor/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0030-apps/mqtt-ingestor/values.yaml.gotmpl
    labels:
      group: apps
{{- end }}

  - name: qdrant
    namespace: {{ $ns }}
    chart: qdrant/qdrant
    version: 1.17.0
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0030-apps/qdrant/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0030-apps/qdrant/values.yaml.gotmpl
    labels:
      group: apps