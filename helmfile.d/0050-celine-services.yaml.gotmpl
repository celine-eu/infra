environments:
  dev:
    values:
      - ../envs/dev/values.yaml
    secrets:
      - ../envs/dev/secrets.sops.yaml
  staging:
    values:
      - ../envs/staging/values.yaml
    secrets:
      - ../envs/staging/secrets.sops.yaml
  prod:
    values:
      - ../envs/prod/values.yaml
    secrets:
      - ../envs/prod/secrets.sops.yaml
---
# repositories:
#   - name: celine-services
#     url: ../charts/celine-services

releases:
  - name: digital-twin
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-digital-twin
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-digital-twin/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-digital-twin/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: dataset-api
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-dataset-api
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-dataset-api/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-dataset-api/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: dataset-api-shell
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-dataset-api-shell
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-dataset-api-shell/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-dataset-api-shell/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: ai-assistant
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-ai-assistant
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-ai-assistant/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-ai-assistant/values.yaml.gotmpl
    labels:
      group: celine-services

  # Operator pod for `celine-assistant kb`. Reads the assistant's defaults first, so
  # the CLI runs with the service's environment (and its KB_GIT_TOKEN secret).
  - name: ai-assistant-shell
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-ai-assistant-shell
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-ai-assistant/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-ai-assistant-shell/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-ai-assistant/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-ai-assistant-shell/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: webapp
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-webapp
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-webapp/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-webapp/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: nudging
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-nudging
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-nudging/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-nudging/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: rec-registry
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-rec-registry
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-rec-registry/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-rec-registry/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: rec-registry-shell
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-rec-registry-shell
    missingFileHandler: Warn
    labels:
      group: celine-services
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-rec-registry-shell/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-rec-registry-shell/values.yaml.gotmpl

  - name: mqtt-auth
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-mqtt-auth
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-mqtt-auth/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-mqtt-auth/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: policies-shell
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-policies-shell
    missingFileHandler: Warn
    labels:
      group: celine-services
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-policies-shell/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-policies-shell/values.yaml.gotmpl

  - name: flexibility-api
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-flexibility-api
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-flexibility-api/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-flexibility-api/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: api-gateway
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/api-gateway
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/api-gateway/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/api-gateway/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: roi
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-roi
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-roi/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-roi/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: frontend-assistant
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-frontend-assistant
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/celine-frontend-assistant/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-frontends/celine-frontend-assistant/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: frontend-webapp
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-frontend-webapp
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/celine-frontend-webapp/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-frontends/celine-frontend-webapp/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: frontend-roi
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-frontend-roi
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/celine-frontend-roi/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-frontends/celine-frontend-roi/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: grid
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-grid
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-grid/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-grid/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: frontend-grid
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-frontend-grid
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/celine-frontend-grid/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-frontends/celine-frontend-grid/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: provisioning
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-provisioning
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-provisioning/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-provisioning/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: community
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-community
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-community/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-community/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: frontend-community
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-frontend-community
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/celine-frontend-community/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-frontends/celine-frontend-community/values.yaml.gotmpl
    labels:
      group: celine-services

  # Onboarding: API and UI, one host. Off unless the environment sets
  # `onboarding.enabled: true`, because it cannot start without values no
  # environment has by default (the encryption key, the forwarded-IP range).
  # See defaults/0050-celine-services/celine-onboarding/values.yaml.gotmpl.
  - name: onboarding
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-onboarding
    createNamespace: true
    installed: {{ .Environment.Values | dig "onboarding" "enabled" false }}
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/values.yaml.gotmpl
      - ../defaults/0050-celine-services/celine-onboarding/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-onboarding/values.yaml.gotmpl
    labels:
      group: celine-services

  # The legal host: the deployment's legal documents as a static site, public. Off until
  # `legal.enabled: true` and `legal.image`. See
  # defaults/0050-celine-services/celine-legal/values.yaml.gotmpl.
  - name: legal
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-legal
    createNamespace: true
    installed: {{ .Environment.Values | dig "legal" "enabled" false }}
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/celine-legal/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-celine-services/celine-legal/values.yaml.gotmpl
    labels:
      group: celine-services

  - name: frontend-onboarding
    namespace: celine-{{ .Environment.Name }}
    chart: ../charts/celine-frontend-onboarding
    createNamespace: true
    installed: {{ .Environment.Values | dig "onboarding" "enabled" false }}
    missingFileHandler: Warn
    values:
      - ../defaults/0050-celine-services/celine-frontend-onboarding/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0050-frontends/celine-frontend-onboarding/values.yaml.gotmpl
    labels:
      group: celine-services
