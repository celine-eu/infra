# Environments: `dev` is the one versioned here; every other one is discovered, any envs/<name>/
# holding a values.yaml (a directory or a link to one, never committed here). Each gets, in
# order: values.yaml, addons.yaml.gotmpl when present (README, "Add-on layer"), its
# secrets.sops.yaml when present. No other environment name is written here.
environments:
  dev:
    values:
      - ../envs/dev/values.yaml
      {{- if isFile "../envs/dev/addons.yaml.gotmpl" }}
      - ../envs/dev/addons.yaml.gotmpl
      {{- end }}
    secrets:
      - ../envs/dev/secrets.sops.yaml
  {{- range $e := readDirEntries "../envs" }}
  {{- $dir := printf "../envs/%s" $e.Name }}
  {{- if and (ne $e.Name "dev") (not (hasPrefix "." $e.Name)) (isFile (printf "%s/values.yaml" $dir)) }}
  {{ $e.Name }}:
    values:
      - {{ $dir }}/values.yaml
      {{- if isFile (printf "%s/addons.yaml.gotmpl" $dir) }}
      - {{ $dir }}/addons.yaml.gotmpl
      {{- end }}
    {{- if isFile (printf "%s/secrets.sops.yaml" $dir) }}
    secrets:
      - {{ $dir }}/secrets.sops.yaml
    {{- end }}
  {{- end }}
  {{- end }}
---
# The namespace: the environment value `namespace`, by default celine-<environment name>.
{{- $ns := .Environment.Values | dig "namespace" (printf "celine-%s" .Environment.Name) | toString }}
repositories:
  - name: prefect
    url: https://prefecthq.github.io/prefect-helm

releases:
  - name: prefect-server
    namespace: {{ $ns }}
    chart: prefect/prefect-server
    # `prefect_server.chart_version`: an environment may run a newer chart (e.g. for
    # `externalDatabase`, the connection read from a database operator's own Secret).
    version: {{ .Environment.Values | dig "prefect_server" "chart_version" "2026.2.19200223" }}
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0040-pipelines/prefect-server/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0040-pipelines/prefect-server/values.yaml.gotmpl
    labels:
      group: pipelines

  - name: prefect-worker
    namespace: {{ $ns }}
    chart: prefect/prefect-worker
    version: 2026.2.19200223
    createNamespace: true
    missingFileHandler: Warn
    needs:
      - {{ $ns }}/prefect-server
    values:
      - ../defaults/0040-pipelines/prefect-worker/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0040-pipelines/prefect-worker/values.yaml.gotmpl
    labels:
      group: pipelines

  - name: prefect-pipelines
    namespace: {{ $ns }}
    chart: ../charts/prefect-pipelines
    version: 0.1.0
    createNamespace: true
    missingFileHandler: Warn
    needs:
      - {{ $ns }}/prefect-worker
    values:
      - ../defaults/0040-pipelines/prefect-pipelines/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0040-pipelines/prefect-pipelines/values.yaml.gotmpl
    labels:
      group: pipelines
    hooks:
      - events: [presync]
        showlogs: true
        command: bash
        args:
          - -c
          - |
            echo "⏳ Waiting for prefect-worker service account..."
            until kubectl get serviceaccount prefect-worker -n {{ $ns }} &>/dev/null; do
              sleep 3
            done
            echo "✅ prefect-worker SA ready"

  - name: pg-freezer
    namespace: {{ $ns }}
    chart: ../charts/pg-freezer
    version: 0.1.0
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0040-pipelines/pg-freezer/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0040-pipelines/pg-freezer/values.yaml.gotmpl
    labels:
      group: pipelines