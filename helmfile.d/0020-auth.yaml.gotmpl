# Environments: `dev` is the one versioned here; every other one is discovered, any envs/<name>/
# holding a values.yaml (a directory or a link to one, never committed here). Each gets, in
# order: values.yaml, addons.yaml.gotmpl when present (README, "Add-on layer"), its
# secrets.sops.yaml when present. No other environment name is written here.
environments:
  dev:
    values:
      - ../envs/dev/values.yaml
      {{- if isFile "../envs/dev/addons.yaml.gotmpl" }}
      - ../envs/dev/addons.yaml.gotmpl
      {{- end }}
    secrets:
      - ../envs/dev/secrets.sops.yaml
  {{- range $e := readDirEntries "../envs" }}
  {{- $dir := printf "../envs/%s" $e.Name }}
  {{- if and (ne $e.Name "dev") (not (hasPrefix "." $e.Name)) (isFile (printf "%s/values.yaml" $dir)) }}
  {{ $e.Name }}:
    values:
      - {{ $dir }}/values.yaml
      {{- if isFile (printf "%s/addons.yaml.gotmpl" $dir) }}
      - {{ $dir }}/addons.yaml.gotmpl
      {{- end }}
    {{- if isFile (printf "%s/secrets.sops.yaml" $dir) }}
    secrets:
      - {{ $dir }}/secrets.sops.yaml
    {{- end }}
  {{- end }}
  {{- end }}
---
# The namespace: the environment value `namespace`, by default celine-<environment name>.
{{- $ns := .Environment.Values | dig "namespace" (printf "celine-%s" .Environment.Name) | toString }}
{{- $keycloakOn := ne (.Environment.Values | dig "keycloak" "enabled" true | toString) "false" }}
{{- /* keycloak.admin_public behind Traefik: the console Ingress's allowlist is the release
       keycloak-admin-allowlist's Middleware, installed with keycloak, admin_public and
       ingress_controller.annotations: traefik, all three (README, "Keycloak admin access"). */}}
{{- $adminPublic := .Environment.Values | dig "keycloak" "admin_public" (dict) | default (dict) }}
{{- $ic := .Environment.Values | dig "ingress_controller" (dict) | default (dict) }}
{{- $adminAllowlist := and $keycloakOn (eq ($adminPublic | dig "enabled" false | toString) "true") (eq ($ic | dig "annotations" "nginx" | toString) "traefik") }}
repositories:
  # - name: codecentric
  #   url: https://codecentric.github.io/helm-charts

  - name: oauth2-proxy
    url: https://oauth2-proxy.github.io/manifests

releases:
  - name: auth-setup
    namespace: {{ $ns }}
    createNamespace: true
    missingFileHandler: Warn
    chart: ../charts/auth-setup
    values:
      - ../defaults/0020-auth/auth-setup/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0020-auth/auth-setup/values.yaml.gotmpl
    labels:
      group: auth

  - name: keycloak
    namespace: {{ $ns }}
    chart: oci://ghcr.io/codecentric/helm-charts/keycloakx
    version: 7.1.4
    # `keycloak.enabled: false`: the environment's realm lives on a Keycloak run elsewhere
    # (`keycloak.public_url`, `keycloak.internal_url`); this release is not installed.
    installed: {{ .Environment.Values | dig "keycloak" "enabled" true }}
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0020-auth/keycloak/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0020-auth/keycloak/values.yaml.gotmpl
    needs:
      - {{ $ns }}/auth-setup
      {{- if $adminAllowlist }}
      - {{ $ns }}/keycloak-admin-allowlist
      {{- end }}
    labels:
      group: auth

  # The Traefik ipAllowList Middleware of the admin console on the public host
  # (keycloak.admin_public behind Traefik, never in prod): the keycloak release's console
  # Ingress names it, and keycloak needs it. A release of its own, not auth-setup's: the
  # environment that runs a shared Keycloak (identity) installs keycloak and this, no auth-setup.
  - name: keycloak-admin-allowlist
    namespace: {{ $ns }}
    chart: ../charts/keycloak-admin-allowlist
    version: 0.1.0
    installed: {{ $adminAllowlist }}
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0020-auth/keycloak-admin-allowlist/values.yaml.gotmpl
    labels:
      group: auth

  - name: oauth2-proxy
    namespace: {{ $ns }}
    chart: oauth2-proxy/oauth2-proxy
    version: 8.3.1
    createNamespace: true
    missingFileHandler: Warn
    values:
      - ../defaults/0020-auth/oauth2-proxy/values.yaml.gotmpl
      - ../envs/{{ .Environment.Name }}/0020-auth/oauth2-proxy/values.yaml.gotmpl
    labels:
      group: auth
